---
import { CLOUDGATE_REPO, GITHUB_REPO, getTags } from '../lib/catalogue';
import { href } from '../lib/site';

const topTags = getTags().slice(0, 5);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <p class="lede">
        Templates for <a href={CLOUDGATE_REPO}>Cloudgate</a>, the self-hosted deployment platform.
        Each one is a folder in <a href={GITHUB_REPO}>octabyte-io/cg-templates</a>, checked by
        Cloudgate before it is published.
      </p>
      <p class="fine">
        Every app listed here belongs to its own authors and is set up from their published images.
        The templates are not affiliated with or endorsed by those projects.
      </p>
    </div>
    <nav aria-label="Browse">
      <h2>Browse</h2>
      <ul>
        <li><a href={href('templates/')}>All templates</a></li>
        {topTags.map((tag) => <li><a href={href(`tags/${tag.slug}/`)}>{tag.name}</a></li>)}
        <li><a href={href('tags/')}>Every tag</a></li>
      </ul>
    </nav>
    <nav aria-label="Contribute">
      <h2>Contribute</h2>
      <ul>
        <li><a href={href('contribute/')}>Add a template</a></li>
        <li><a href={`${GITHUB_REPO}/issues`}>Request an app</a></li>
        <li><a href={GITHUB_REPO}>Source on GitHub</a></li>
        <li><a href={CLOUDGATE_REPO}>Cloudgate on GitHub</a></li>
      </ul>
    </nav>
    <nav aria-label="For tools">
      <h2>For tools</h2>
      <ul>
        <li><a href={href('templates.json')}>templates.json</a></li>
        <li><a href={href('llms.txt')}>llms.txt</a></li>
        <li><a href={href('sitemap-index.xml')}>Sitemap</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>© {year} Octabyte</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    border-top: 1px solid var(--line);
    background: var(--panel-2);
    font-size: var(--text-ui);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 3rem 2.5rem;
  }

  .about {
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: 30rem;
  }

  .lede {
    color: var(--tx-2);
    line-height: 1.6;
  }

  .fine {
    color: var(--tx-3);
    font-size: var(--text-meta);
    line-height: 1.55;
  }

  h2 {
    margin-bottom: 0.75rem;
    color: var(--tx);
    font-size: var(--text-ui);
    font-weight: 600;
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    color: var(--tx-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--brand-tx);
    text-decoration: underline;
  }

  .base {
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--tx-3);
    font-size: var(--text-meta);
  }

  @media (max-width: 52rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
