---
import type { Template } from '../lib/catalogue';

/**
 * What setting a template up creates, drawn the way Cloudgate's own Plan
 * shows it: one line per Service and Domain, all creates, reviewed before
 * Apply. It is the site's one recurring visual, because the Plan is the
 * product's promise: nothing is created before you have read this list.
 */
interface Props {
  template: Template;
  environment?: string;
  /** Reveal the lines one by one, once, on page load. */
  animate?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { template, environment = 'production', animate = false, headingLevel = 'h3' } = Astro.props;

const lines = [
  ...template.services.map((service) => {
    const images =
      service.kind === 'compose'
        ? template.composeServices.map((composeService) => composeService.image).filter(Boolean)
        : [];
    return {
      name: service.configName,
      what: service.kindLabel,
      detail: images.length ? images.join(', ') : service.detail,
    };
  }),
  ...template.domains.map((domain) => ({
    name: 'Domain',
    what: `${domain.service}, port ${domain.port}`,
    detail: 'generated host',
  })),
  // A template's own `web` gets the usual generated Domain, unwritten in template.yaml.
  ...template.services
    .filter((service) => service.kind === 'web')
    .map((service) => ({ name: 'Domain', what: service.configName, detail: 'generated host' })),
];

const generatedCount = template.generated.length;
const askedCount = template.asked.length;
const Heading = headingLevel;
---

<figure class:list={['plan', { animate }]} style={`--lines: ${lines.length}`}>
  <div class="plan-head">
    <Heading class="plan-title">Plan for <span class="env">{environment}</span></Heading>
    <span class="plan-count">{lines.length} to create</span>
  </div>
  <ol class="plan-lines">
    {
      lines.map((line, index) => (
        <li style={`--i: ${index}`}>
          <span class="sign" aria-hidden="true">+</span>
          <span class="visually-hidden">Create</span>
          <span class="line-name mono">{line.name}</span>
          <span class="line-what">{line.what}</span>
          {line.detail && <span class="line-detail mono">{line.detail}</span>}
        </li>
      ))
    }
  </ol>
  <div class="plan-foot">
    <span class="apply" aria-hidden="true">Apply</span>
    <figcaption>
      {
        generatedCount + askedCount > 0 ? (
          <>
            {askedCount > 0 && `${askedCount} ${askedCount === 1 ? 'value' : 'values'} asked at setup. `}
            {generatedCount > 0 && `${generatedCount} generated for you. `}
            Nothing exists until you apply.
          </>
        ) : (
          'Nothing exists until you apply.'
        )
      }
    </figcaption>
  </div>
</figure>

<style>
  .plan {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--panel);
    box-shadow: var(--shadow-pop);
  }

  .plan-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
  }

  .plan-title {
    font-size: var(--text-ui);
    font-weight: 600;
  }

  .env {
    padding: 0.125rem 0.4rem;
    border-radius: 4px;
    background: var(--raise);
    font-family: var(--font-mono);
    font-size: var(--text-chip);
    font-weight: 500;
  }

  .plan-count {
    color: var(--ok);
    font-size: var(--text-meta);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .plan-lines {
    margin: 0;
    padding: 0.375rem 0;
    list-style: none;
  }

  .plan-lines li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 9.5rem) minmax(0, 1fr);
    grid-template-areas:
      'sign name what'
      '. . detail';
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.5rem 1.125rem;
    font-size: var(--text-ui);
  }

  .plan-lines li + li {
    border-top: 1px dashed var(--line);
  }

  .sign {
    grid-area: sign;
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid var(--ok-line);
    border-radius: 4px;
    background: var(--ok-tint);
    color: var(--ok);
    font-family: var(--font-mono);
    font-size: var(--text-chip);
    font-weight: 600;
    line-height: 1;
    align-self: center;
  }

  .line-name {
    grid-area: name;
    overflow: hidden;
    color: var(--tx);
    font-size: var(--text-meta);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .line-what {
    grid-area: what;
    color: var(--tx-2);
  }

  .line-detail {
    grid-area: detail;
    overflow-wrap: anywhere;
    color: var(--tx-3);
    font-size: var(--text-chip);
  }

  .plan-foot {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1.125rem;
    border-top: 1px solid var(--line);
  }

  .apply {
    flex: none;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-s);
    background: var(--brand);
    color: #fff;
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1;
  }

  figcaption {
    color: var(--tx-3);
    font-size: var(--text-meta);
    line-height: 1.45;
  }

  /* The one orchestrated moment: the Plan is read line by line, then Apply lights. */
  .animate .plan-lines li {
    animation: line-in 420ms var(--ease-out) both;
    animation-delay: calc(300ms + var(--i) * 140ms);
  }

  .animate .apply {
    animation: apply-on 500ms var(--ease-out) both;
    animation-delay: calc(420ms + var(--lines) * 140ms);
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }

  @keyframes apply-on {
    from {
      background: var(--raise-2);
      color: var(--tx-3);
    }
  }

  @media (max-width: 30rem) {
    .plan-lines li {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      grid-template-areas:
        'sign name'
        '. what'
        '. detail';
    }
  }
</style>
