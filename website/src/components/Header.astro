---
import { href } from '../lib/site';
import { GITHUB_REPO } from '../lib/catalogue';

const nav = [
  { label: 'Templates', path: 'templates/' },
  { label: 'Tags', path: 'tags/' },
  { label: 'Add a template', path: 'contribute/' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href={href()} aria-label="Cloudgate Templates, home">
      <img class="mark mark-light" src={href('cloudgate-mark.svg')} alt="" width="29" height="18" />
      <img class="mark mark-dark" src={href('cloudgate-mark-dark.svg')} alt="" width="29" height="18" />
      <span class="name">Cloudgate</span>
      <span class="sub">Templates</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={href(item.path)}
                aria-current={current.startsWith(href(item.path)) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={GITHUB_REPO} class="icon-link" rel="noopener">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            <span class="visually-hidden">cg-templates on GitHub</span>
          </a>
        </li>
        <li>
          <button class="icon-link theme-toggle" type="button" aria-label="Switch to dark theme">
            <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
              ><circle cx="10" cy="10" r="3.5"></circle><path
                d="M10 1.75v1.5M10 16.75v1.5M1.75 10h1.5M16.75 10h1.5M4.17 4.17l1.06 1.06M14.77 14.77l1.06 1.06M4.17 15.83l1.06-1.06M14.77 5.23l1.06-1.06"
              ></path></svg
            >
            <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
              ><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z"></path></svg
            >
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
  const label = () => {
    button?.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme');
  };
  label();
  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    label();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--ground) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tx);
    text-decoration: none;
  }

  .name {
    font-size: 0.9375rem;
    font-weight: 650;
    letter-spacing: -0.28px;
  }

  .sub {
    padding-left: 0.5rem;
    border-left: 1px solid var(--line-2);
    color: var(--tx-3);
    font-size: 0.9375rem;
    font-weight: 450;
  }

  .mark-dark {
    display: none;
  }

  :global(:root[data-theme='dark']) .mark-light {
    display: none;
  }

  :global(:root[data-theme='dark']) .mark-dark {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .mark-light {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .mark-dark {
      display: block;
    }
  }

  ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .icon-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.625rem;
    border-radius: var(--radius-s);
    color: var(--tx-2);
    font-size: var(--text-ui);
    font-weight: 500;
    text-decoration: none;
  }

  nav a:hover,
  .icon-link:hover {
    background: var(--raise);
    color: var(--tx);
  }

  nav a[aria-current='page'] {
    color: var(--tx);
  }

  .icon-link {
    justify-content: center;
    min-width: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon {
    display: block;
  }

  :global(:root[data-theme='dark']) .sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .sub {
      display: none;
    }

    nav li:nth-child(2),
    nav li:nth-child(3) {
      display: none;
    }
  }
</style>
