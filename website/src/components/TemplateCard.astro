---
import type { Template } from '../lib/catalogue';
import { href } from '../lib/site';

interface Props {
  template: Template;
  headingLevel?: 'h2' | 'h3';
}

const { template, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const parts = [...new Set(template.services.map((service) => service.kindLabel))];
---

<article
  class="card"
  data-template
  data-name={template.name.toLowerCase()}
  data-search={`${template.name} ${template.description} ${template.tags.join(' ')} ${template.id}`.toLowerCase()}
  data-tags={template.tags.join(' ')}
>
  <img
    class="logo"
    src={href(template.logo.path)}
    alt=""
    width="44"
    height="44"
    loading="lazy"
    decoding="async"
  />
  <div class="body">
    <Heading class="title">
      <a href={href(`templates/${template.id}/`)}>{template.name}</a>
      {template.version && <span class="version">{template.version}</span>}
    </Heading>
    <p class="description">{template.description}</p>
  </div>
  <p class="parts">
    <span class="visually-hidden">Creates: </span>{parts.join(', ')}
  </p>
</article>

<style>
  .card {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    column-gap: 0.875rem;
    row-gap: 1rem;
    padding: 1.125rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--panel);
  }

  .card:hover {
    border-color: var(--brand-line);
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--brand-ring);
    outline-offset: 2px;
  }

  .logo {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-s);
    object-fit: contain;
  }

  .body {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  .title {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--text-body);
    line-height: 1.3;
  }

  .title a {
    color: var(--tx);
    text-decoration: none;
  }

  .title a:focus-visible {
    outline: none;
  }

  /* The whole card is the link's hit area. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .version {
    color: var(--tx-3);
    font-family: var(--font-mono);
    font-size: var(--text-chip);
    font-weight: 400;
  }

  .description {
    display: -webkit-box;
    overflow: hidden;
    color: var(--tx-2);
    font-size: var(--text-ui);
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .parts {
    grid-column: 1 / -1;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--tx-3);
    font-size: var(--text-meta);
  }
</style>
