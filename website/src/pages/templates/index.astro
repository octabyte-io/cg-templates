---
import Base from '../../layouts/Base.astro';
import TemplateGrid from '../../components/TemplateGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTags, getTemplates } from '../../lib/catalogue';
import { breadcrumbSchema, graph, itemListSchema } from '../../lib/schema';
import { href } from '../../lib/site';

const templates = getTemplates();
const tags = getTags();
const trail = [
  { name: 'Home', path: '' },
  { name: 'Templates', path: 'templates/' },
];
const jsonLd = graph(
  breadcrumbSchema(trail),
  {
    '@type': 'CollectionPage',
    name: 'All Cloudgate templates',
    description: `Browse ${templates.length} templates for self-hosting open-source apps with Cloudgate.`,
  },
  itemListSchema(templates, 'All Cloudgate templates'),
);
---

<Base
  title="All templates"
  description={`Browse ${templates.length} ready-made templates for self-hosting open-source apps with Cloudgate, searchable by name and filterable by tag.`}
  path="templates/"
  jsonLd={jsonLd}
>
  <div class="wrap page">
    <Breadcrumbs trail={trail} />
    <header class="head">
      <h1>All templates</h1>
      <p>
        {templates.length} apps you can set up in a Cloudgate Environment. Search by name, or narrow
        the list by tag.
      </p>
    </header>

    <div class="filters" data-filters>
      <div class="search">
        <label for="q" class="visually-hidden">Search templates</label>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
          ><circle cx="8.75" cy="8.75" r="5.75"></circle><path d="m13 13 4.25 4.25"></path></svg
        >
        <input id="q" name="q" type="search" placeholder="Search by name, tag or what it does" autocomplete="off" />
      </div>
      <ul class="tag-filter" aria-label="Filter by tag">
        <li>
          <a class="chip" href={href('templates/')} data-tag="" aria-current="page">All</a>
        </li>
        {
          tags.map((tag) => (
            <li>
              <a class="chip" href={href(`tags/${tag.slug}/`)} data-tag={tag.slug}>
                {tag.name}
                <span class="chip-count">{tag.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="status" role="status" aria-live="polite" data-status>
      Showing all {templates.length} templates
    </p>

    <TemplateGrid templates={templates} headingLevel="h2" id="results" />

    <div class="empty" data-empty hidden>
      <h2>No template matches</h2>
      <p>
        Try another word or clear the tag. If the app you want is missing, you can <a
          href={href('contribute/')}>add it</a
        >.
      </p>
      <button type="button" class="button button-quiet" data-clear>Clear search and tag</button>
    </div>
  </div>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('#q');
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('[data-tag]')];
  const items = [...document.querySelectorAll<HTMLElement>('#results > li')];
  const status = document.querySelector<HTMLElement>('[data-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const total = items.length;

  const params = new URLSearchParams(location.search);
  let query = params.get('q') ?? '';
  let tag = params.get('tag') ?? '';
  if (input) input.value = query;

  function apply(push = false) {
    const words = query.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const card = item.querySelector<HTMLElement>('[data-template]');
      const haystack = card?.dataset.search ?? '';
      const itemTags = (card?.dataset.tags ?? '').split(' ');
      const match = words.every((word) => haystack.includes(word)) && (!tag || itemTags.includes(tag));
      item.hidden = !match;
      if (match) shown += 1;
    }
    for (const chip of chips) {
      if ((chip.dataset.tag ?? '') === tag) chip.setAttribute('aria-current', 'page');
      else chip.removeAttribute('aria-current');
    }
    const tagName = chips.find((chip) => chip.dataset.tag === tag)?.firstChild?.textContent?.trim();
    if (status) {
      status.textContent =
        shown === total
          ? `Showing all ${total} templates`
          : `Showing ${shown} of ${total} templates${tag ? ` tagged ${tagName}` : ''}${query ? ` matching “${query}”` : ''}`;
    }
    if (empty) empty.hidden = shown !== 0;

    const next = new URLSearchParams();
    if (query) next.set('q', query);
    if (tag) next.set('tag', tag);
    const url = `${location.pathname}${next.size ? `?${next}` : ''}`;
    if (push) history.pushState(null, '', url);
    else history.replaceState(null, '', url);
  }

  input?.addEventListener('input', () => {
    query = input.value.trim();
    apply();
  });

  for (const chip of chips) {
    chip.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      tag = chip.dataset.tag === tag ? '' : (chip.dataset.tag ?? '');
      apply(true);
    });
  }

  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    query = '';
    tag = '';
    if (input) input.value = '';
    apply(true);
    input?.focus();
  });

  addEventListener('popstate', () => {
    const now = new URLSearchParams(location.search);
    query = now.get('q') ?? '';
    tag = now.get('tag') ?? '';
    if (input) input.value = query;
    apply();
  });

  apply();
</script>

<style>
  .page {
    padding-top: 1.5rem;
  }

  .head {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
    margin-block: 1.5rem 2rem;
  }

  h1 {
    font-size: var(--text-title);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .head p {
    color: var(--tx-2);
    font-size: var(--text-lead);
  }

  .filters {
    position: sticky;
    top: 3.75rem;
    z-index: 5;
    display: grid;
    gap: 0.875rem;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.875rem var(--gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--ground) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    max-width: 32rem;
    padding: 0 0.875rem;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-m);
    background: var(--panel);
    color: var(--tx-3);
  }

  .search:focus-within {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand-tint);
  }

  .search input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: none;
    color: var(--tx);
    font: inherit;
    outline: none;
  }

  .search input::placeholder {
    color: var(--tx-ph);
  }

  .tag-filter {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 0.125rem;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
  }

  .status {
    margin-block: 1.25rem 1rem;
    color: var(--tx-3);
    font-size: var(--text-meta);
  }

  .empty {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 32rem;
    padding: 2.5rem 0;
  }

  .empty[hidden] {
    display: none;
  }

  .empty h2 {
    font-size: var(--text-sect);
  }

  .empty p {
    color: var(--tx-2);
  }
</style>
