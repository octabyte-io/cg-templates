---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanReadout from '../../components/PlanReadout.astro';
import TemplateGrid from '../../components/TemplateGrid.astro';
import Faq from '../../components/Faq.astro';
import {
  formatMemory,
  getTemplates,
  GITHUB_REPO,
  relatedTemplates,
  runsOnSentence,
  tagName,
  type Template,
} from '../../lib/catalogue';
import { mergeFaq, SETUP_STEPS, templateFaq } from '../../lib/copy';
import { breadcrumbSchema, faqSchema, graph, howToSchema, softwareSchema } from '../../lib/schema';
import { formatDate, href } from '../../lib/site';

export function getStaticPaths() {
  return getTemplates().map((template) => ({ params: { id: template.id }, props: { template } }));
}

interface Props {
  template: Template;
}

const { template } = Astro.props;
const related = relatedTemplates(template);
const faq = mergeFaq(template.faq, templateFaq(template));

const steps = SETUP_STEPS.map((step, index) =>
  index === 0
    ? { name: `Pick ${template.name}`, text: `Open Templates in your Cloudgate console and choose ${template.name}.` }
    : step,
);

const GENERATED_LABEL: Record<string, string> = {
  password: 'A 32-character password',
  hex: 'A random hex key',
  base64: 'A random base64 key',
  uuid: 'A random UUID',
  jwt: 'A signed JSON Web Token',
};

const FORMAT_LABEL: Record<string, string> = {
  email: 'An email address',
  url: 'A URL',
  number: 'A number',
};

const trail = [
  { name: 'Home', path: '' },
  { name: 'Templates', path: 'templates/' },
  { name: template.name, path: `templates/${template.id}/` },
];

const jsonLd = graph(
  breadcrumbSchema(trail),
  softwareSchema(template),
  howToSchema(template, steps),
  faqSchema(faq),
);

const title = `Self-host ${template.name} with Cloudgate`;
// Search results show about 160 characters, so the suffix is added only where it fits.
const suffix = ` Self-host it on your own Server with a Cloudgate template.`;
const description =
  template.description.length + suffix.length <= 160 ? template.description + suffix : template.description;

const links = [
  { label: 'Website', url: template.links.website },
  { label: 'Documentation', url: template.links.docs },
  { label: 'Source code', url: template.links.source },
].filter((link): link is { label: string; url: string } => Boolean(link.url));
---

<Base
  title={title}
  description={description}
  path={`templates/${template.id}/`}
  jsonLd={jsonLd}
  ogImage={`og/${template.id}.png`}
  ogType="article"
>
  <div class="wrap page">
    <Breadcrumbs trail={trail} />

    <header class="head">
      <img
        class="logo"
        src={href(template.logo.path)}
        alt={`${template.name} logo`}
        width="72"
        height="72"
      />
      <div class="head-copy">
        <h1>
          {template.name}
          {template.version && <span class="version">{template.version}</span>}
        </h1>
        <p class="lede">{template.description}</p>
        <ul class="tags" aria-label="Tags">
          {
            template.tags.map((tag) => (
              <li>
                <a class="chip" href={href(`tags/${tag}/`)}>
                  {tagName(tag)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </header>

    <div class="layout">
      <div class="main">
        <section aria-labelledby="creates-title" class="block">
          <h2 id="creates-title">What setting it up creates</h2>
          <p class="block-lede">
            Setting up {template.name} adds these to the Environment you choose. You see this list as
            a Plan in your console, and nothing is created until you apply it.
          </p>
          <PlanReadout template={template} />
        </section>

        {
          template.bodyHtml && (
            <section class="block" aria-label={`About ${template.name}`}>
              <div class="prose" set:html={template.bodyHtml} />
            </section>
          )
        }

        {
          (template.asked.length > 0 || template.generated.length > 0 || template.fixed.length > 0) && (
            <section aria-labelledby="values-title" class="block">
              <h2 id="values-title">Values it needs</h2>
              <p class="block-lede">
                Each value is made once, at setup, and saved in your Environment like any variable
                you typed.
              </p>
              {template.asked.length > 0 && (
                <div class="table-wrap">
                  <table>
                    <caption>Asked at setup</caption>
                    <thead>
                      <tr>
                        <th scope="col">Value</th>
                        <th scope="col">Variable</th>
                        <th scope="col">Notes</th>
                      </tr>
                    </thead>
                    <tbody>
                      {template.asked.map((value) => (
                        <tr>
                          <td>
                            {value.label}
                            {value.description && <span class="cell-note">{value.description}</span>}
                          </td>
                          <td>
                            <code>{value.name}</code>
                          </td>
                          <td class="notes">
                            {[
                              value.format && FORMAT_LABEL[value.format],
                              value.secret && 'Kept secret',
                              value.required ? 'Required' : 'Optional',
                              value.default && `Defaults to ${value.default}`,
                            ]
                              .filter(Boolean)
                              .join('. ')}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {template.generated.length > 0 && (
                <div class="table-wrap">
                  <table>
                    <caption>Generated for you</caption>
                    <thead>
                      <tr>
                        <th scope="col">Variable</th>
                        <th scope="col">What is made</th>
                      </tr>
                    </thead>
                    <tbody>
                      {template.generated.map((value) => (
                        <tr>
                          <td>
                            <code>{value.name}</code>
                          </td>
                          <td>{GENERATED_LABEL[value.kind] ?? value.kind}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </section>
          )
        }

        {
          template.screenshots.length > 0 && (
            <section aria-labelledby="shots-title" class="block">
              <h2 id="shots-title">Screenshots</h2>
              <div class="shots">
                {template.screenshots.map((shot, index) => (
                  <img
                    src={href(shot.path)}
                    alt={`${template.name} screenshot ${index + 1}`}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
            </section>
          )
        }

        <section aria-labelledby="setup-title" class="block">
          <h2 id="setup-title">Set up {template.name}</h2>
          <ol class="setup">
            {
              steps.map((step) => (
                <li>
                  <h3>{step.name}</h3>
                  <p>{step.text}</p>
                </li>
              ))
            }
          </ol>
        </section>

        <div class="block">
          <Faq items={faq} title={`Questions about ${template.name}`} />
        </div>
      </div>

      <aside class="facts" aria-label="Template facts">
        <dl>
          <div>
            <dt>Template id</dt>
            <dd><code>{template.id}</code></dd>
          </div>
          {
            template.version && (
              <div>
                <dt>App version</dt>
                <dd>{template.version}</dd>
              </div>
            )
          }
          <div>
            <dt>Runs on</dt>
            <dd>{runsOnSentence(template.runsOn)}</dd>
          </div>
          {
            template.size && (
              <div>
                <dt>Minimum size</dt>
                <dd>
                  {template.size.name}, {template.size.cpu} CPU and {formatMemory(template.size.memoryMb)}
                </dd>
              </div>
            )
          }
          {
            template.cloudgate && (
              <div>
                <dt>Needs Cloudgate</dt>
                <dd>{template.cloudgate} or newer</dd>
              </div>
            )
          }
          {
            template.updated && (
              <div>
                <dt>Last changed</dt>
                <dd>
                  <time datetime={template.updated.toISOString()}>{formatDate(template.updated)}</time>
                </dd>
              </div>
            )
          }
        </dl>
        {
          links.length > 0 && (
            <ul class="links">
              {links.map((link) => (
                <li>
                  <a href={link.url} rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
        <a class="button button-quiet files" href={`${GITHUB_REPO}/tree/main/${template.folder}`}>
          View the template's files
        </a>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Similar templates</h2>
          <TemplateGrid templates={related} />
        </section>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-top: 1.5rem;
  }

  .head {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-block: 1.75rem 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .logo {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-m);
    object-fit: contain;
  }

  .head-copy {
    display: grid;
    gap: 0.875rem;
  }

  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.875rem;
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .version {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-s);
    background: var(--panel);
    color: var(--tx-2);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-weight: 500;
    letter-spacing: 0;
  }

  .lede {
    max-width: 44rem;
    color: var(--tx-2);
    font-size: var(--text-lead);
    line-height: 1.55;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: clamp(2rem, 1rem + 3vw, 4.5rem);
    align-items: start;
  }

  .main {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    min-width: 0;
  }

  .block {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .block > h2 {
    font-size: var(--text-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .block-lede {
    max-width: var(--measure);
    color: var(--tx-2);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--panel);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-ui);
  }

  caption {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
    font-weight: 600;
    text-align: left;
  }

  th,
  td {
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  th {
    color: var(--tx-3);
    font-size: var(--text-meta);
    font-weight: 500;
  }

  tbody tr {
    border-top: 1px solid var(--line);
  }

  td code {
    font-size: var(--text-meta);
  }

  .cell-note {
    display: block;
    margin-top: 0.25rem;
    color: var(--tx-3);
    font-size: var(--text-meta);
  }

  .notes {
    color: var(--tx-2);
  }

  .shots {
    display: grid;
    gap: 1rem;
  }

  .shots img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }

  .setup {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: setup;
  }

  .setup li {
    position: relative;
    padding-left: 2.75rem;
    counter-increment: setup;
  }

  .setup li::before {
    content: counter(setup);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    border: 1px solid var(--brand-line);
    border-radius: 50%;
    background: var(--panel);
    color: var(--brand-tx);
    font-size: var(--text-meta);
    font-weight: 600;
  }

  .setup h3 {
    padding-top: 0.25rem;
    font-size: var(--text-body);
  }

  .setup p {
    margin-top: 0.25rem;
    color: var(--tx-2);
    line-height: 1.6;
  }

  .facts {
    position: sticky;
    top: 5.25rem;
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--panel);
    box-shadow: var(--shadow-panel);
    font-size: var(--text-ui);
  }

  dl {
    display: grid;
    gap: 0.875rem;
    margin: 0;
  }

  dt {
    color: var(--tx-3);
    font-size: var(--text-meta);
  }

  dd {
    margin: 0.125rem 0 0;
    color: var(--tx);
  }

  .links {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .files {
    width: 100%;
  }

  .related {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--line);
  }

  .related h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
  }

  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .facts {
      position: static;
      grid-row: 1;
    }
  }

  @media (max-width: 30rem) {
    .head {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .logo {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
</style>
