---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTags, getTemplates } from '../../lib/catalogue';
import { breadcrumbSchema, graph } from '../../lib/schema';
import { href } from '../../lib/site';

const tags = getTags();
const templates = getTemplates();
const trail = [
  { name: 'Home', path: '' },
  { name: 'Tags', path: 'tags/' },
];
const examples = (slug: string) =>
  templates
    .filter((template) => template.tags.includes(slug))
    .slice(0, 3)
    .map((template) => template.name);
---

<Base
  title="Templates by tag"
  description={`Browse Cloudgate templates by what they do: ${tags
    .slice(0, 6)
    .map((tag) => tag.name.toLowerCase())
    .join(', ')} and more.`}
  path="tags/"
  jsonLd={graph(breadcrumbSchema(trail))}
>
  <div class="wrap page">
    <Breadcrumbs trail={trail} />
    <header class="head">
      <h1>Templates by tag</h1>
      <p>{tags.length} tags across {templates.length} templates.</p>
    </header>
    <ul class="tag-list">
      {
        tags.map((tag) => (
          <li>
            <a href={href(`tags/${tag.slug}/`)}>
              <span class="tag-name">{tag.name}</span>
              <span class="tag-count">
                {tag.count} {tag.count === 1 ? 'template' : 'templates'}
              </span>
              <span class="tag-examples">{examples(tag.slug).join(', ')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: 1.5rem;
  }

  .head {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem 2rem;
  }

  h1 {
    font-size: var(--text-title);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .head p {
    color: var(--tx-2);
    font-size: var(--text-lead);
  }

  .tag-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .tag-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    height: 100%;
    padding: 1.125rem 0.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--tx);
    text-decoration: none;
  }

  .tag-list li:not(:last-child) a {
    margin-right: 1.5rem;
  }

  .tag-list a:hover .tag-name {
    color: var(--brand-tx);
    text-decoration: underline;
  }

  .tag-name {
    font-weight: 600;
  }

  .tag-count {
    color: var(--tx-3);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .tag-examples {
    grid-column: 1 / -1;
    color: var(--tx-2);
    font-size: var(--text-ui);
  }
</style>
