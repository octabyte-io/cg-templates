<script>
  // The copy button on the setup note. Without JavaScript the commands are still selectable text.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const source = document.getElementById(button.dataset.copy ?? '');
    const status = button.closest('div.grow')?.querySelector<HTMLElement>('[data-copy-status]');
    button.addEventListener('click', async () => {
      const text = source?.textContent ?? '';
      let done = false;
      try {
        await navigator.clipboard.writeText(text);
        done = true;
      } catch {
        const range = document.createRange();
        if (source) {
          range.selectNodeContents(source);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
      button.textContent = done ? 'Copied' : 'Selected';
      if (status) status.textContent = done ? 'Install commands copied' : 'Install commands selected; press Ctrl C to copy';
      window.setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  }
</script>
