---
import Base from '../layouts/Base.astro';
import Chev from '../components/Chev.astro';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
import { isSample } from '../lib/catalogue';
import { breadcrumbSchema, faqSchema, graph, ORGANIZATION } from '../lib/schema';
import { absolute, GET_CLOUDGATE_URL, href } from '../lib/site';

// Every requirement, command and claim on this page comes from Cloudgate's own README.md,
// docs/deploy.md and LICENSE. Change them there first; this page follows.
const DEPLOY_GUIDE = `${GET_CLOUDGATE_URL.replace(/\/$/, '')}/blob/main/docs/deploy.md`;
const LICENSE_URL = 'https://www.elastic.co/licensing/elastic-license';

const trail = [
  { name: 'Apps', path: '' },
  { name: 'Get Cloudgate', path: 'get-cloudgate/' },
];

const description =
  'Cloudgate is a free, self-hosted platform for running apps on a server you own. See what you need, the two-command install and what to do next.';

// docs/deploy.md §2: the clone and the one install script. Nothing else is needed to install.
const installCommands = `git clone git@github.com:octabyte-io/cloudgate.git /opt/cloudgate
CLOUDGATE_PUBLIC_HOST=<public ip or hostname> bash /opt/cloudgate/deploy/install.sh`;

// docs/deploy.md §1 "What you need", and §7 (the installer is amd64 only).
const spec = [
  ['System', 'Ubuntu 24.04'],
  ['Size', '2 vCPU, 4 GB memory, 40 GB disk'],
  ['Processor', 'x86-64 (amd64) only; ARM is not supported'],
  ['Access', 'root over SSH'],
  ['Ports open inbound', '22, 80, 443, 3000, 4000'],
  ['DNS', 'none required (sslip.io)'],
];

const after = [
  {
    name: 'Open the console',
    text: 'Go to the address the install prints and create your account. The first account owns this Cloudgate; everyone after it joins by invitation.',
  },
  {
    name: 'Connect a server',
    text: 'On the Servers screen, choose Add a Server. The server Cloudgate is installed on can run your apps too, so this can be the same one.',
  },
  {
    name: 'Pick an app',
    text: 'Choose one from this catalogue. Every app here is also on the console’s Templates screen, ready to set up.',
  },
  {
    name: 'Set it up',
    text: 'Click Set up and choose where it runs. Cloudgate lists everything it will create, and nothing happens until you apply it.',
  },
];

const faq = [
  {
    q: 'Is Cloudgate free?',
    a: 'Yes. Anyone, individual or business, may use and self-host it for free. It is published under the Elastic License 2.0, which makes it source-available rather than open source: the one thing you may not do is offer Cloudgate to other people as a hosted service. A few business features, such as single sign-on, custom roles and white-labelling, need a paid licence. Your server is the only bill.',
  },
  {
    q: 'Do I need to be technical?',
    a: 'To use it, no. Once it is running, everything happens in the console in your browser: choose an app, choose a server, review, apply. The install is different: someone needs to be comfortable connecting to a server and running two commands. Send them the setup note on this page.',
  },
  {
    q: 'Can I install it on a server I already have?',
    a: 'If it runs Ubuntu 24.04 on an ordinary x86 processor, yes. Cloudgate is built for a fresh server, though: the install sets up Docker, a database and a firewall of its own, so a new, empty server is the safer choice.',
  },
  {
    q: 'Do I need a domain name?',
    a: 'No. Without one, each app gets a free web address built from your server’s IP address, which is how Cloudgate’s own test installs reached their apps. You can give an app your own domain whenever you like.',
  },
  {
    q: 'Is there a hosted version of Cloudgate?',
    a: 'Not today. The only way to get Cloudgate is to install it on a server you control, which keeps the console, your apps and their data on machines you choose.',
  },
  {
    q: 'What else can Cloudgate do besides installing apps from this catalogue?',
    a: 'It is a full deployment platform. It can deploy your own code from GitHub, GitLab, Bitbucket or Gitea on every push, with preview copies of a change and one-click rollback. It runs managed Postgres, MySQL, MariaDB, MongoDB and Redis databases with scheduled backups. It checks that your apps are up and alerts you by email, Slack, Microsoft Teams, Discord or Telegram when one is not, and it shows logs and resource use for each app.',
  },
  {
    q: 'What if I get stuck?',
    a: 'Cloudgate’s deployment guide covers the install step by step, including what has gone wrong on real installs and how to fix it. If something is still broken, open an issue on Cloudgate’s GitHub page. Please report a security problem privately, as the project’s security policy describes, not in a public issue.',
  },
];

const cloudgate = {
  '@type': 'SoftwareApplication',
  '@id': `${absolute('get-cloudgate/')}#cloudgate`,
  name: 'Cloudgate',
  description:
    'A self-hosted deployment platform: a console you open in the browser to run apps and databases on servers you own.',
  url: absolute('get-cloudgate/'),
  sameAs: [GET_CLOUDGATE_URL],
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Ubuntu 24.04',
  processorRequirements: '2 vCPU, x86-64',
  memoryRequirements: '4 GB',
  storageRequirements: '40 GB',
  featureList: [
    'One-click setup of open-source apps from the Cloudgate Templates catalogue',
    'Deploy from GitHub, GitLab, Bitbucket or Gitea on every push, with preview deployments and rollback',
    'Managed Postgres, MySQL, MariaDB, MongoDB and Redis databases with scheduled backups',
    'Automatic https certificates for your own domains',
    'Uptime checks and alerts by email, Slack, Microsoft Teams, Discord or Telegram',
    'Team roles with access limited to chosen projects and apps',
  ],
  license: LICENSE_URL,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@id': ORGANIZATION['@id'] },
};

const jsonLd = graph(breadcrumbSchema(trail), cloudgate, faqSchema(faq));
---

<Base
  title="Install Cloudgate on your own server, free"
  description={description}
  path="get-cloudgate/"
  jsonLd={jsonLd}
  noindex={isSample}
>
  <Crumbs trail={trail} />

  <section class="apphead pad gc-hero">
    <div class="body">
      <h1 class="h1">Get Cloudgate</h1>
      <p class="lede">
        Cloudgate is a console you open in your browser to run apps on servers you own. Connect a server, pick an app,
        and Cloudgate builds it, runs it and gives it a secure web address, with backups and logs in the same place.
      </p>
      <div class="acts">
        <a class="btn lg" href={GET_CLOUDGATE_URL}>View Cloudgate on GitHub</a>
        <a class="btn lg ghost" href="#setup">Read the setup note <Chev /></a>
      </div>
      <p class="facts-strip">
        <span><b>Free</b> to self-host</span>
        <span>You pay only for your server</span>
        <span>Source-available, Elastic License 2.0</span>
      </p>
    </div>
  </section>

  <section class="sec" aria-labelledby="need-title">
    <div class="shead pad">
      <h2 class="h2" id="need-title">What you need</h2>
      <p class="lede">A server, someone to run the install once, and that is it. A domain name is optional.</p>
    </div>
    <div class="bento need">
      <div class="tile pad">
        <div class="tx">
          <h3 class="h3">A server</h3>
          <p>A virtual server rented from any hosting provider, or one of your own. This size is enough, and it is the size Cloudgate is tested on.</p>
        </div>
        <div class="frag server" role="img" aria-label="Server size: Ubuntu 24.04, 2 processor cores, 4 GB memory, 40 GB disk, a standard x86 processor">
          <div class="top1" aria-hidden="true"><b>Your server</b><span class="status"><i></i>Ubuntu 24.04</span></div>
          <div class="r" aria-hidden="true"><span>Processor</span><span>2 cores</span></div>
          <div class="r" aria-hidden="true"><span>Memory</span><span>4 GB</span></div>
          <div class="r" aria-hidden="true"><span>Disk</span><span>40 GB</span></div>
          <div class="r" aria-hidden="true"><span>Type</span><span>Standard (x86), not ARM</span></div>
        </div>
      </div>
      <div class="tile pad">
        <div class="tx">
          <h3 class="h3">A domain name, if you like</h3>
          <p>Not needed to start. Each app can get a free web address built from your server’s IP address, without https. Use your own domain whenever you want, and Cloudgate gets its https certificate for you.</p>
        </div>
        <div class="frag addr" role="img" aria-label="Example web addresses: n8n-3f9a1c-203-0-113-10.sslip.io without a domain, n8n.acmebakery.com with your own">
          <div class="r" aria-hidden="true"><span>Without a domain</span><span class="a">n8n-3f9a1c-203-0-113-10.sslip.io</span></div>
          <div class="r" aria-hidden="true"><span>With your own</span><span class="a">n8n.acmebakery.com</span></div>
        </div>
      </div>
      <div class="tile pad">
        <div class="tx">
          <h3 class="h3">A few minutes, once</h3>
          <p>The install is one script that does everything. On Cloudgate’s test server it finished in under four minutes. Not comfortable with a terminal? Hand the setup note below to someone who is.</p>
        </div>
        <div class="frag prog" role="img" aria-label="Example install progress: Docker, database, console and firewall set up, done in 3 minutes 20 seconds">
          <ul aria-hidden="true">
            <li><span class="ok">✓</span>Docker</li>
            <li><span class="ok">✓</span>Database</li>
            <li><span class="ok">✓</span>Console</li>
            <li><span class="ok">✓</span>Firewall</li>
          </ul>
          <div class="foot1" aria-hidden="true"><span><b>Done.</b> Open the console</span><span class="t">3 min 20 s</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="cost-title">
    <div class="pad cost">
      <div class="tx">
        <h2 class="h2" id="cost-title">How to get it, and what it costs</h2>
        <p>
          Today there is one way to get Cloudgate: install it on a server you control, yourself or with the help of
          someone technical. The software is free for individuals and businesses alike. It is licensed under the
          <a href={LICENSE_URL}>Elastic License 2.0</a>, which lets anyone use, self-host and change it for free, but not
          offer it to other people as a hosted service.
        </p>
      </div>
      <div class="frag" role="img" aria-label="What you pay: Cloudgate free, apps from this catalogue free, your server at your provider's price, business features such as single sign-on on a paid licence">
        <div class="price bill" aria-hidden="true">
          <span>Cloudgate</span><span>Free</span>
          <span>Apps from this catalogue</span><span>Free</span>
          <span class="tot">Your server</span><span class="tot">Your provider’s price</span>
        </div>
        <p class="ex">Single sign-on, custom roles and white-labelling need a paid licence</p>
      </div>
    </div>
  </section>

  <section class="sec stagewrap gc-setup" id="setup" aria-labelledby="setup-title">
    <div class="shead">
      <h2 class="h2" id="setup-title">For whoever sets up your server</h2>
      <p class="lede">
        Send this part to the person who looks after your servers. It is the whole install, from Cloudgate’s deployment
        guide.
      </p>
    </div>
    <div class="stage">
      <div class="window note">
        <div class="wbar">
          <b>Setup note</b>
          <span aria-hidden="true">/</span>
          <span>Cloudgate install</span>
          <span class="sp"></span>
          <a class="guide" href={DEPLOY_GUIDE}>Full guide <Chev /></a>
        </div>
        <div class="nbody">
          <dl class="spec">
            {
              spec.map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))
            }
          </dl>
          <ol class="isteps">
            <li>
              <span class="n">1</span>
              <div>
                <b>Check the ports</b>
                <p>Make sure no firewall at your hosting provider blocks the ports listed here. A blocked port looks exactly like a broken install.</p>
              </div>
            </li>
            <li>
              <span class="n">2</span>
              <div>
                <b>Arrange repository access</b>
                <p>The Cloudgate repository is private for now, so the clone uses SSH and needs a deploy key on the server.</p>
              </div>
            </li>
            <li>
              <span class="n">3</span>
              <div class="grow">
                <b>Run the install as root</b>
                <p>The checkout must be at <code>/opt/cloudgate</code>. The public address is built into the console, so changing it later means a rebuild.</p>
                <div class="cmd">
                  <div class="cbar">
                    <span>On the server, as root</span>
                    <button class="btn sm ghost copy" type="button" data-copy="install-cmd" aria-label="Copy the install commands">Copy</button>
                  </div>
                  <pre class="code" id="install-cmd"><code>{installCommands}</code></pre>
                </div>
                <p class="sr" role="status" aria-live="polite" data-copy-status></p>
              </div>
            </li>
            <li>
              <span class="n">4</span>
              <div>
                <b>Claim it, and keep the secrets</b>
                <p>
                  Open <code>http://&lt;host&gt;:3000/sign-up</code>: the first account owns the instance. Back up
                  <code>/etc/default/cloudgate-secrets</code>; without it the encrypted data cannot be read. The console runs on plain
                  HTTP, so read the guide’s security section before giving it a public address.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="after-title">
    <div class="shead pad">
      <h2 class="h2" id="after-title">Once it is running</h2>
      <p class="lede">From here on, everything happens in the console in your browser.</p>
    </div>
    <div class="pad">
      <ol class="after">
        {
          after.map((step, index) => (
            <li>
              <span class="n">Step {index + 1}</span>
              <b>{step.name}</b>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="next">
        <a class="btn ghost" href={`${href()}#catalogue`}>Browse apps <Chev /></a>
        <a class="btn ghost" href={href('templates/')}>Every app <Chev /></a>
        <a class="lnk" href={href('how-it-works/')}>How Cloudgate works</a>
        <a class="lnk" href={href('why-cloudgate/')}>Why run apps on your own server</a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="faq-title">
    <div class="pad faqwrap">
      <h2 class="h2" id="faq-title">Questions</h2>
      <Faq items={faq} />
      <div class="end">
        <a class="btn lg" href={GET_CLOUDGATE_URL}>View Cloudgate on GitHub</a>
        <a class="btn lg ghost" href={DEPLOY_GUIDE}>Read the deployment guide <Chev /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .gc-hero {
    grid-template-columns: 1fr;
    padding-block: 28px 56px;
  }
  .gc-hero .lede {
    max-width: 60ch;
  }
  .gc-hero .facts-strip {
    margin-top: 6px;
  }

  /* What you need: three equal tiles on the hairline bento grid */
  .need > .tile {
    grid-column: span 2;
  }
  .addr .r,
  .server .r {
    flex-wrap: wrap;
  }
  .addr .r {
    display: flex;
    justify-content: space-between;
    gap: 4px 10px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 13px;
  }
  .addr .r:first-child {
    padding-top: 0;
  }
  .addr .r:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .addr .r span:first-child {
    color: var(--faint);
  }
  .addr .a {
    font: 12.5px var(--mono);
    overflow-wrap: anywhere;
  }
  .prog ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .prog li {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 7px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg);
  }
  .prog .ok {
    color: var(--ok);
  }
  .prog .t {
    font: 12px var(--mono);
  }

  /* How to get it, and what it costs */
  .cost {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: 24px 64px;
    align-items: center;
    padding-block: 64px;
  }
  .cost .tx {
    display: grid;
    gap: 14px;
    max-width: 62ch;
  }
  .cost .tx p {
    color: var(--muted);
    font-size: 16px;
  }
  .cost a,
  .lnk {
    color: var(--accent-ink);
  }
  .bill {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .cost .ex {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  /* The setup note: the page's one stage */
  .gc-setup {
    padding-inline: max(16px, env(safe-area-inset-left, 0px));
  }
  .gc-setup .shead {
    padding-inline: 0;
  }
  .note .wbar {
    min-width: 0;
  }
  .note .wbar > span:nth-of-type(2) {
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .guide {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-ink);
    text-decoration: none;
    font-weight: 500;
  }
  .guide:hover {
    text-decoration: underline;
  }
  .nbody {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
  }
  .spec {
    margin: 0;
    padding: 18px 20px;
    background: var(--sunk);
    border-right: 1px solid var(--line);
    display: grid;
    gap: 2px;
    align-content: start;
    font-size: 13.5px;
  }
  .spec dt {
    color: var(--faint);
    font-size: 12.5px;
    padding-top: 10px;
  }
  .spec dt:first-child {
    padding-top: 0;
  }
  .spec dd {
    margin: 0;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line);
  }
  .spec dd:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .isteps {
    list-style: none;
    margin: 0;
    padding: 8px 22px;
    display: grid;
    min-width: 0;
  }
  .isteps > li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  .isteps > li:last-child {
    border-bottom: 0;
  }
  .isteps > li > div {
    display: grid;
    gap: 4px;
    min-width: 0;
    max-width: 72ch;
  }
  .isteps .n {
    font: 11px var(--mono);
    width: 22px;
    height: 22px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--card);
    color: var(--accent-ink);
    margin-top: 1px;
  }
  .isteps b {
    font-weight: 600;
    font-size: 14.5px;
  }
  .isteps p {
    color: var(--muted);
    font-size: 14px;
  }
  .isteps code {
    font: 12.5px var(--mono);
    background: var(--sunk);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 4px;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .cmd {
    margin-top: 10px;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
  }
  .cbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 6px 6px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--card);
    font-size: 12.5px;
    color: var(--faint);
  }
  .cmd .code {
    background: var(--sunk);
    white-space: pre;
    border: 0;
    border-radius: 0;
  }
  .cmd .code code {
    font: inherit;
    background: none;
    border: 0;
    padding: 0;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Once it is running: a real sequence, so numbered */
  .after {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
    overflow: hidden;
  }
  .after > li {
    padding: 20px 22px;
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
  }
  .after > li + li {
    border-left: 1px solid var(--line);
  }
  .after .n {
    font: 12px var(--mono);
    color: var(--accent-ink);
  }
  .after b {
    font-weight: 600;
  }
  .after p {
    color: var(--muted);
    font-size: 14px;
  }
  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    padding-block: 24px 64px;
    font-size: 14.5px;
  }
  .next .btn + .lnk {
    margin-left: 8px;
  }

  .faqwrap {
    display: grid;
    gap: 16px;
    padding-block: 64px;
  }
  .faqwrap :global(.faq) {
    max-width: 80ch;
  }
  .end {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  @media (min-width: 760px) {
    .gc-setup {
      padding-inline: 48px;
    }
  }
  @media (max-width: 1100px) {
    .after {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .after > li + li {
      border-left: 0;
    }
    .after > li:nth-child(even) {
      border-left: 1px solid var(--line);
    }
    .after > li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 900px) {
    .need > .tile {
      grid-column: 1 / -1;
    }
    .cost {
      grid-template-columns: 1fr;
    }
    .nbody {
      grid-template-columns: 1fr;
    }
    .spec {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 16px;
    }
    .spec dt,
    .spec dt:first-child {
      padding-block: 8px;
      border-bottom: 1px dashed var(--line);
    }
    .spec dd {
      padding-block: 8px;
      text-align: right;
    }
    .spec dt:nth-last-of-type(1) {
      border-bottom: 0;
    }
  }
  @media (max-width: 640px) {
    .gc-hero {
      padding-block: 20px 40px;
    }
    .gc-hero .acts {
      display: flex;
    }
    .gc-hero .acts .btn {
      flex: 1;
    }
    .cost,
    .faqwrap {
      padding-block: 48px;
    }
    .isteps {
      padding: 4px 14px;
    }
    .after {
      grid-template-columns: 1fr;
    }
    .after > li:nth-child(even) {
      border-left: 0;
    }
    .after > li + li {
      border-top: 1px solid var(--line);
    }
    .note .wbar > span:nth-of-type(1),
    .note .wbar > span:nth-of-type(2) {
      display: none;
    }
    .end .btn {
      flex: 1;
    }
  }
</style>

<script>
  // The copy button on the setup note. Without JavaScript the commands are still selectable text.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const source = document.getElementById(button.dataset.copy ?? '');
    const status = button.closest('div.grow')?.querySelector<HTMLElement>('[data-copy-status]');
    button.addEventListener('click', async () => {
      const text = source?.textContent ?? '';
      let done = false;
      try {
        await navigator.clipboard.writeText(text);
        done = true;
      } catch {
        const range = document.createRange();
        if (source) {
          range.selectNodeContents(source);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
      }
      button.textContent = done ? 'Copied' : 'Selected';
      if (status) status.textContent = done ? 'Install commands copied' : 'Install commands selected; press Ctrl C to copy';
      window.setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  }
</script>
