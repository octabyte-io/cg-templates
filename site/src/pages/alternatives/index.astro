---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import ProductTile from '../../components/ProductTile.astro';
import { alternativesPages, lastUpdated } from '../../lib/catalogue';
import { breadcrumbSchema, graph, pageListSchema } from '../../lib/schema';
import { href } from '../../lib/site';

const pages = alternativesPages().sort((a, b) => b.apps.length - a.apps.length || a.product.name.localeCompare(b.product.name));
// Tools with several apps get a card to compare; tools with one app get a compact A to Z list, so
// the page stays scannable instead of a wall of "1 app" cards.
const compared = pages.filter((page) => page.apps.length > 1);
const single = pages.filter((page) => page.apps.length === 1).sort((a, b) => a.product.name.localeCompare(b.product.name));
const trail = [
  { name: 'Home', path: '' },
  { name: 'Alternatives', path: 'alternatives/' },
];
---

<Base
  title="Open-source alternatives to tools you pay for"
  description={`Free, self-hosted replacements for ${pages
    .slice(0, 5)
    .map((page) => page.product.name)
    .join(', ')} and more, ready to run on your own server.`}
  path="alternatives/"
  pageType="CollectionPage"
  dateModified={lastUpdated(pages.flatMap((page) => page.apps))}
  jsonLd={graph(
    breadcrumbSchema(trail),
    pageListSchema(
      'Open-source alternatives to tools you pay for',
      pages.map((page) => ({ name: `${page.product.name} alternatives`, path: `alternatives/${page.product.id}/` })),
    ),
  )}
>
  <Crumbs trail={trail} />
  <section class="apphead one pad">
    <div class="body">
      <h1 class="h1">Open-source alternatives to the tools you pay for</h1>
      <p class="lede">Find the free app that does the job of a tool you pay for today, and run it on your own server. To weigh one app against one tool in depth, see the <a href={href('compare/')}>head-to-head comparisons</a>.</p>
    </div>
  </section>
  <section class="sec browse pad" aria-labelledby="compared-title">
    <h2 class="h2" id="compared-title">Tools with several alternatives</h2>
    <div class="idx">
      {
        compared.map((page) => (
          <a href={href(`alternatives/${page.product.id}/`)}>
            <b>
              <ProductTile product={page.product} box={32} size={18} />
              {page.product.name} alternatives
            </b>
            <span>{page.apps.map((app) => app.name).join(', ')}</span>
            <small>
              {page.apps.length} {page.apps.length === 1 ? 'app' : 'apps'} for {page.product.job}
            </small>
          </a>
        ))
      }
    </div>
  </section>
  {
    single.length > 0 && (
      <section class="sec browse pad" aria-labelledby="single-title">
        <h2 class="h2" id="single-title">More tools, A to Z</h2>
        <p class="muted measure">Each of these has one app in the catalogue that does the same job.</p>
        <ul class="azlist">
          {single.map((page) => (
            <li>
              <a href={href(`alternatives/${page.product.id}/`)}>{page.product.name} alternative</a>
              <span>{page.apps[0].name}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .lede a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }
</style>
