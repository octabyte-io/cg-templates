---
import Base from '../../layouts/Base.astro';
import AppTile from '../../components/AppTile.astro';
import Card from '../../components/Card.astro';
import Chev from '../../components/Chev.astro';
import Crumbs from '../../components/Crumbs.astro';
import ConsoleDeploy from '../../components/ConsoleDeploy.astro';
import Ease from '../../components/Ease.astro';
import Faq from '../../components/Faq.astro';
import ProductMark from '../../components/ProductMark.astro';
import Screens from '../../components/Screens.astro';
import { alternativesPages, getTemplates, listNames, relatedTemplates, type Template } from '../../lib/catalogue';
import { appFaq, HOW_IT_WORKS } from '../../lib/copy';
import { breadcrumbSchema, faqSchema, graph, howToSchema, softwareSchema } from '../../lib/schema';
import { deployUrl, formatDate, href } from '../../lib/site';

export function getStaticPaths() {
  return getTemplates().map((template) => ({ params: { id: template.id }, props: { template } }));
}

interface Props {
  template: Template;
}

const { template: a } = Astro.props;
const related = relatedTemplates(a);
const faq = appFaq(a);
const steps = HOW_IT_WORKS(a);
const replacedNames = a.alternativeTo.map((p) => p.name);
const altPages = new Map(alternativesPages().map((page) => [page.product.id, page]));
// Link the alternatives page that compares the most apps, or else the first product's page.
const mainAlt =
  a.alternativeTo.find((p) => (altPages.get(p.id)?.apps.length ?? 0) > 1) ?? a.alternativeTo.find((p) => altPages.has(p.id));
const mainAltMany = mainAlt ? (altPages.get(mainAlt.id)?.apps.length ?? 0) > 1 : false;
const easeNote =
  a.easeNote ?? (a.ease === 'easy' ? 'Ready to use right after setup.' : 'Takes a few extra minutes to configure after it starts.');
const deploy = deployUrl(a.id);

const trail = [
  { name: 'Home', path: '' },
  { name: a.category.name, path: `categories/${a.category.id}/` },
  { name: a.name, path: `templates/${a.id}/` },
];

// The title leads with the search people make ("self-hosted alternative to Zapier") and falls back
// to shorter wordings so it fits the roughly 60 characters a results page shows, " | Cloudgate"
// included. The last wording is used even when it is longer.
const titles = replacedNames.length
  ? [
      `${a.name}: free, self-hosted alternative to ${listNames(replacedNames.slice(0, 2))}`,
      `${a.name}: free, self-hosted alternative to ${replacedNames[0]}`,
      `${a.name}: self-hosted ${replacedNames[0]} alternative`,
      `${a.name}: ${replacedNames[0]} alternative`,
    ]
  : [`${a.name}: ${a.tagline.replace(/\.$/, '')}`, `Self-host ${a.name}`];
const title = titles.find((t) => t.length <= 48) ?? titles[titles.length - 1];

// template.yaml's description is a card line (50-160 characters); the meta description adds what
// a searcher wants to know next, and stops at a sentence so it is never cut mid-word.
const sentences = [
  a.description.replace(/\s*$/, ''),
  replacedNames.length ? `A free, open-source alternative to ${listNames(replacedNames.slice(0, 2))}.` : 'Free and open source.',
];
const closers = ['Deploy it in a few clicks with Cloudgate, no server needed.', 'Deploy it in a few clicks with Cloudgate.', 'Deploy it with Cloudgate.'];
const lead = sentences.reduce((out, next) => (`${out} ${next}`.length <= 160 ? `${out} ${next}` : out));
const closer = closers.find((line) => `${lead} ${line}`.length <= 160);
const description = closer ? `${lead} ${closer}` : lead;

const jsonLd = graph(breadcrumbSchema(trail), softwareSchema(a), howToSchema(a, steps), faqSchema(faq));
---

<Base
  title={title}
  description={description}
  path={`templates/${a.id}/`}
  jsonLd={jsonLd}
  ogImage={`og/${a.id}.png`}
  ogType="article"
  markdown={`templates/${a.id}.md`}
  pageType="ItemPage"
  dateModified={a.updated}
>
  <Crumbs trail={trail} />
  <section class="apphead pad">
    <AppTile template={a} box={80} size={46} />
    <div class="body">
      <h1 class="h1">{a.name}</h1>
      <p class="lede">{a.tagline}</p>
      <div class="chips">
        {
          a.alternativeTo.length > 0 && (
            <span class="chip">
              Replaces
              {a.alternativeTo.map((p) => (
                <b class="chipmark">
                  <ProductMark product={p} />
                  {p.name}
                </b>
              ))}
            </span>
          )
        }
        <span class="chip"><Ease ease={a.ease} /></span>
        <span class="chip"><b>Free</b> app</span>
      </div>
      <div class="acts">
        <a class="btn lg" href={deploy}>Deploy {a.name}</a>
        {a.links.website && <a class="btn lg ghost" href={a.links.website} rel="noopener">Official website <Chev /></a>}
      </div>
      <p class="dnote">No server needed to start: Cloudgate can provide one. <a href="#deploy">What happens when you click Deploy</a></p>
    </div>
  </section>

  {a.screenshots.length > 0 && <Screens template={a} />}

  <div class="sec pad split">
    <div>
      <div class="blk first">
        <h2 class="h2">What is {a.name}?</h2>
        <div class="prose">
          <p>{a.description}</p>
          {a.bodyHtml && <Fragment set:html={a.bodyHtml} />}
        </div>
      </div>

      <div class="blk">
        <h2 class="h2">What you can do with {a.name}</h2>
        <ul class="feat">
          {
            a.features.map((feature) => (
              <li>
                <b>{feature.title}</b>
                <span>{feature.text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      {
        a.alternativeTo.length > 0 && (
          <div class="blk">
            <h2 class="h2">Replaces {listNames(replacedNames)}</h2>
            <p class="muted measure">
              {a.name} does the same job as {listNames(replacedNames)}.
              {a.switching ? ' Here is what changes when you switch.' : ' It runs on a server of your own, so the cost stays the same however many people use it, and your data stays with you.'}
            </p>
            {a.switching && (
              <div class="vs">
                <div>
                  <span class="t">What you gain</span>
                  <ul>
                    {a.switching.gain.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
                <div>
                  <span class="t">What is different</span>
                  <ul>
                    {a.switching.different.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
            {mainAlt && (
              <a href={href(`alternatives/${mainAlt.id}/`)} class="btn ghost start">
                {mainAltMany ? `Compare all ${mainAlt.name} alternatives` : `Moving from ${mainAlt.name} to ${a.name}`} <Chev />
              </a>
            )}
          </div>
        )
      }

      <div class="blk" id="deploy">
        <h2 class="h2">What happens when you click Deploy?</h2>
        <p class="muted measure">
          You do not need a server or any technical knowledge. Four steps, and {a.name} is running at its own web address.
        </p>
        <ol class="dsteps">
          {
            steps.map((step, index) => (
              <li>
                <span class="n">Step {index + 1}</span>
                <b>{step.name}</b>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="dfoot">
          <a class="btn lg" href={deploy}>Deploy {a.name}</a>
          <p class="muted">
            New to Cloudgate? <a href={href('get-cloudgate/')}>See the ways to get it</a>
          </p>
        </div>
        <ConsoleDeploy id={a.id} name={a.name} />
      </div>

      <div class="blk">
        <h2 class="h2">Questions</h2>
        <Faq items={faq} />
      </div>

      {
        related.length > 0 && (
          <div class="blk last">
            <h2 class="h2">Related apps</h2>
            <div class="rel">
              {related.map((template) => (
                <Card template={template} />
              ))}
            </div>
          </div>
        )
      }
    </div>

    <aside aria-label={`${a.name} at a glance`}>
      <div class="sidecard">
        <div class="hd"><AppTile template={a} box={32} size={18} /><b>{a.name} at a glance</b></div>
        <dl>
          <dt>Category</dt><dd><a class="plain" href={href(`categories/${a.category.id}/`)}>{a.category.name}</a></dd>
          <dt>Ease of use</dt><dd><Ease ease={a.ease} /></dd>
          <dt>App price</dt><dd>Free</dd>
          <dt>Server</dt><dd>Yours, or one from Cloudgate</dd>
          <dt>Code</dt><dd title={`Licence: ${a.license}`}>Open source</dd>
          {
            a.updated && (
              <>
                <dt>Last updated</dt>
                <dd>
                  <time datetime={a.updated.toISOString()}>{formatDate(a.updated)}</time>
                </dd>
              </>
            )
          }
        </dl>
        <p class="enote">{easeNote}</p>
        <div class="links">
          {a.links.website && <a href={a.links.website} rel="noopener">Official website <Chev /></a>}
          {a.links.docs && <a href={a.links.docs} rel="noopener">Documentation <Chev /></a>}
          <a href={a.links.source} rel="noopener">Source code <Chev /></a>
        </div>
        <div class="ft">
          <a class="btn lg wide" href={deploy}>Deploy {a.name}</a>
          <p>Ready in a few minutes. No server? Cloudgate can provide one.</p>
          <ConsoleDeploy id={a.id} name={a.name} center />
        </div>
      </div>
    </aside>
  </div>
  <div class="mspace"></div>
  <div class="mbar">
    <div class="t"><b>{a.name}</b><span>Free app</span></div>
    <a class="btn lg" href={deploy}>Deploy {a.name}</a>
  </div>
</Base>

<style>
  .chipmark {
    display: inline-flex;
    gap: 5px;
    align-items: center;
  }
  .shots {
    margin-top: 16px;
  }
  .measure {
    max-width: 64ch;
  }
  .start {
    justify-self: start;
  }
  .enote {
    padding: 0 18px 12px;
    font-size: var(--t-sm);
    color: var(--muted);
  }

  .dnote {
    font-size: .875rem;
    color: var(--muted);
  }
  .dnote a,
  .dfoot a:not(.btn) {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }

  /* What happens when you click Deploy: a real sequence, so numbered */
  #deploy {
    scroll-margin-top: calc(var(--hh) + 16px);
  }
  .dsteps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--card);
    overflow: hidden;
  }
  .dsteps > li {
    padding: 20px 22px;
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
  }
  .dsteps > li:nth-child(even) {
    border-left: 1px solid var(--line);
  }
  .dsteps > li:nth-child(n + 3) {
    border-top: 1px solid var(--line);
  }
  .dsteps .n {
    font: .75rem var(--mono);
    color: var(--accent-ink);
  }
  .dsteps b {
    font-weight: 600;
  }
  .dsteps p {
    color: var(--muted);
    font-size: .875rem;
  }
  .dfoot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
    font-size: .875rem;
  }
  @media (max-width:40em) {
    .dsteps {
      grid-template-columns: 1fr;
    }
    .dsteps > li:nth-child(even) {
      border-left: 0;
    }
    .dsteps > li + li {
      border-top: 1px solid var(--line);
    }
    .dnote {
      display: none;
    }
    .dfoot .btn {
      width: 100%;
    }
  }
</style>
