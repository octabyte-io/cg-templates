---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Chev from '../../components/Chev.astro';
import Crumbs from '../../components/Crumbs.astro';
import { alternativesPages, getTemplates, isSample, lastUpdated, usedCategories } from '../../lib/catalogue';
import { breadcrumbSchema, graph, itemListSchema } from '../../lib/schema';
import { href } from '../../lib/site';

// Every app, all in the HTML. The filter bar only narrows what is shown, and the home page's
// SearchAction lands here with ?q=, so the filter reads it on load.
const templates = getTemplates();
const total = templates.length;
const categories = usedCategories();
const alternatives = alternativesPages();
const trail = [
  { name: 'Home', path: '' },
  { name: 'All apps', path: 'templates/' },
];
const title = 'All open-source apps you can self-host';
const description = `All ${total} free, open-source apps you can run on your own server with Cloudgate. Filter by what you need done, or by a tool you pay for today.`;
---

<Base
  title={title}
  description={description}
  path="templates/"
  noindex={isSample}
  pageType="CollectionPage"
  dateModified={lastUpdated(templates)}
  jsonLd={graph(breadcrumbSchema(trail), itemListSchema(templates, title))}
>
  <Crumbs trail={trail} />
  <section class="apphead one pad">
    <div class="body">
      <h1 class="h1">All {total} self-hosted apps</h1>
      <p class="lede">
        Every app here is free and open source. Each one does the job of a tool many businesses pay for, and runs on a
        server you choose. Open an app to see what it does and how to set it up with Cloudgate.
      </p>
      <div class="chips">
        <span class="chip"><b>{total}</b> apps</span>
        <span class="chip"><b>{categories.length}</b> categories</span>
        <span class="chip"><b>Free</b> to use</span>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="list-title">
    <h2 class="visually-hidden" id="list-title">App list</h2>
    <div class="fbar">
      <div class="in pad">
        <div class="seg" role="toolbar" aria-label="Filter by category">
          <button type="button" data-tab="" aria-pressed="true">All</button>
          {categories.map((category) => <button type="button" data-tab={category.id} aria-pressed="false">{category.name}</button>)}
        </div>
        <label class="sbox"
          ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
            ><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg
          >
          <input id="q" type="search" autocomplete="off" placeholder="Filter, e.g. Slack" aria-label="Filter apps" /></label
        >
      </div>
    </div>
    <div class="gridwrap pad">
      <div class="grid" id="grid">
        {templates.map((template) => <Card template={template} />)}
        <div class="empty" id="empty" hidden>
          <p class="msg" id="emptyMsg"></p>
          <p class="hint">Try a tool you pay for, like Zapier, Notion or Slack. If the app you need is missing, you can add it.</p>
          <div class="eacts">
            <button type="button" class="btn sm ghost" id="clear">Clear the filter</button>
            <a class="btn sm ghost" href={href('contribute/')}>Add an app <Chev /></a>
          </div>
        </div>
      </div>
      <p class="fine" id="count" aria-live="polite">All {total} apps shown</p>
      <p class="fine legend">
        <span><span class="ease easy"><i></i>Easy</span>: ready to use right after setup.</span>
        <span><span class="ease some"><i></i>Some setup</span>: a few extra minutes of setup inside the app.</span>
      </p>
    </div>
  </section>

  <section class="sec pad more-browse" aria-labelledby="more-title">
    <h2 class="h2" id="more-title">Other ways to browse</h2>
    <div class="idx">
      <a href={href('categories/')}>
        <b>By category</b>
        <span>Apps grouped by the job they do, from websites to team chat.</span>
        <small>{categories.length} categories</small>
      </a>
      <a href={href('alternatives/')}>
        <b>By the tool you pay for</b>
        <span>Find the free app that replaces a tool like Zapier, Slack or Notion.</span>
        <small>{alternatives.length} tools with alternatives</small>
      </a>
      <a href={href('contribute/')}>
        <b>Add an app</b>
        <span>Missing an app? Add it from your browser, without installing anything.</span>
        <small>From your browser, in a few minutes</small>
      </a>
    </div>
  </section>
</Base>

<style>
  .more-browse {
    padding-block: 40px 64px;
  }
  .more-browse .h2 {
    margin-bottom: 20px;
  }
  .empty .msg {
    color: var(--fg);
    font-weight: 500;
    margin: 0;
  }
  .empty .hint {
    margin: 6px auto 0;
    max-width: 52ch;
  }
  .eacts {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  @media (max-width:40em) {
    .empty {
      padding: 28px 18px;
    }
  }
</style>

<script>
  // Category tabs and the filter box. Every card is in the HTML, so the page reads completely
  // without JavaScript; this only narrows what is shown and keeps ?q= and ?category= in the URL,
  // so a filtered list can be shared and the home page's search lands on its results.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const input = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const emptyMsg = document.getElementById('emptyMsg') as HTMLElement;
  const clear = document.getElementById('clear') as HTMLButtonElement;
  const count = document.getElementById('count') as HTMLElement;
  const total = cards.length;
  const known = new Set(tabs.map((t) => t.dataset.tab ?? ''));

  const params = new URLSearchParams(location.search);
  let cat = params.get('category') ?? '';
  if (!known.has(cat)) cat = '';
  input.value = params.get('q') ?? '';

  function syncUrl() {
    const url = new URL(location.href);
    const q = input.value.trim();
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    if (cat) url.searchParams.set('category', cat);
    else url.searchParams.delete('category');
    history.replaceState(history.state, '', url);
  }

  function render() {
    const raw = input.value.trim();
    const q = raw.toLowerCase();
    const matches = cards.filter((c) => (!cat || c.dataset.cat === cat) && (!q || (c.dataset.q ?? '').includes(q)));
    cards.forEach((c) => (c.hidden = !matches.includes(c)));
    tabs.forEach((t) => t.setAttribute('aria-pressed', String((t.dataset.tab ?? '') === cat)));
    const catName = tabs.find((t) => t.dataset.tab === cat)?.textContent;
    empty.hidden = matches.length > 0;
    emptyMsg.textContent = raw
      ? `No apps match “${raw}”${cat ? ` in ${catName}` : ''}.`
      : `No apps in ${catName} yet.`;
    count.textContent =
      matches.length === total
        ? `All ${total} apps shown`
        : `${matches.length} of ${total} ${total === 1 ? 'app' : 'apps'} shown`;
    syncUrl();
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      cat = t.dataset.tab ?? '';
      render();
      t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }),
  );
  input.addEventListener('input', render);
  clear.addEventListener('click', () => {
    cat = '';
    input.value = '';
    render();
    input.focus();
  });
  render();
  // Bring the selected tab into view on phones, where the tabs scroll sideways (above 640px they wrap).
  // Scrolls only the tab row, never the page.
  const picked = cat ? tabs.find((t) => t.dataset.tab === cat) : undefined;
  const row = picked?.parentElement;
  if (picked && row) {
    const over = picked.getBoundingClientRect().right - row.getBoundingClientRect().right;
    if (over > 0) row.scrollLeft += over + 8;
  }
</script>
