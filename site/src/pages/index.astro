---
import Base from '../layouts/Base.astro';
import AppTile from '../components/AppTile.astro';
import ProductTile from '../components/ProductTile.astro';
import Card from '../components/Card.astro';
import Check from '../components/Check.astro';
import Chev from '../components/Chev.astro';
import Faq from '../components/Faq.astro';
import { alternativesPages, getTemplate, getTemplates, listNames, popularSwaps, usedCategories } from '../lib/catalogue';
import { faqSchema, graph, itemListSchema, websiteSchema } from '../lib/schema';
import { costAnswer, HOW_IT_WORKS } from '../lib/copy';
import { cloudgate, href, SITE_DESCRIPTION } from '../lib/site';

const templates = getTemplates();
const total = templates.length;
const categories = usedCategories();
const swaps = popularSwaps();
const topAlternatives = alternativesPages().sort((a, b) => b.apps.length - a.apps.length)[0];
// The home page shows a first screenful; the rest are a click away, and all of them are on /templates/.
const PAGE = 8;

// The stage shows a real app from the catalogue being set up; n8n when it is there.
const featured = getTemplate('n8n') ?? templates[0];
const replaced = featured?.alternativeTo[0];
const second = templates.find((t) => t.id === 'plausible') ?? templates.find((t) => t.id !== featured?.id);
const steps = featured ? HOW_IT_WORKS(featured) : [];
const nights = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Tonight'];
const seats = ['AK', 'JB', 'LM', 'SR', 'TO', 'EV', 'PN', 'MC', 'RD', 'HW', 'CL', 'NB'];

// Answers written to be quoted as they stand: each one names its subject instead of saying "it",
// and the examples come from the catalogue, so they stay true as apps are added.
const exampleSwaps = swaps.slice(0, 3);
const faq = [
  {
    q: 'What is Cloudgate Templates?',
    a: `Cloudgate Templates is a free directory of ${total} open-source apps${
      exampleSwaps.length
        ? `, such as ${listNames(exampleSwaps.map((swap) => `${swap.app.name} instead of ${swap.product.name}`))}`
        : ''
    }. Pick one and click Deploy, and Cloudgate, a deployment platform, sets it up on a server for you and gives it a web address.`,
  },
  {
    q: 'Do I need my own server?',
    a: 'No. When you deploy an app, hosted Cloudgate can provide a server: pick a size and a country, and it is set up for you. If you already rent a server, you can connect it instead.',
  },
  {
    q: 'Do I need to be technical?',
    a: 'No. Pick an app, click Deploy, create your Cloudgate account and choose a server. Cloudgate does the setup, and you use the app in your browser like any online tool. Some apps need a few minutes of setup inside the app itself; their pages are marked “Some setup”.',
  },
  {
    q: 'What does it cost?',
    a: costAnswer(),
  },
  {
    q: 'What is Cloudgate?',
    a: 'Cloudgate is a deployment platform made by Octabyte: a console in your browser that sets up and runs apps on servers and gives each app a web address. You can use it hosted, or install it on your own server for free. Its features, pricing and docs are at cloudgate.octabyte.io.',
  },
  {
    q: 'Is my app secure on its web address?',
    a: 'Every app gets a free web address to start, which uses plain http, so it is not encrypted. Add your own domain, like crm.yourshop.com, and Cloudgate sets up https for it automatically.',
  },
  {
    q: 'Can I suggest or add an app?',
    a: 'Yes. Each app is a small folder of text files in the Cloudgate Templates repository on GitHub. Anyone can add one with a pull request from the GitHub website, without installing anything.',
  },
];

const jsonLd = graph(websiteSchema(), itemListSchema(templates, 'Open-source apps on Cloudgate'), faqSchema(faq));
---

<Base
  title="Deploy free open-source apps in a few clicks | Cloudgate"
  bareTitle
  description={SITE_DESCRIPTION}
  path=""
  jsonLd={jsonLd}
>
  <section class="hero pad">
    <h1 class="display">Open-source apps, ready to run on your own server</h1>
    <div class="row2">
      <p class="lede">
        Pick a free app that does the job of a tool you pay for today and click Deploy. No server yet? Cloudgate can
        provide one, so your app is live in minutes with nothing to install.
      </p>
      <div class="acts">
        <a class="btn lg" href="#catalogue">Browse {total} apps</a>
        <a class="btn lg ghost" href={href('how-it-works/')}>How it works <Chev /></a>
      </div>
    </div>
    <div class="facts-strip"><span><b>{total}</b> free apps</span><span><b>Nothing</b> to install</span><span>Server provided if you need one</span></div>
  </section>

  {
    featured && (
      <section class="stagewrap pad" id="how" aria-labelledby="how-title">
        <h2 id="how-title" class="visually-hidden">How it works</h2>
        <div class="stage">
          <div class="window demo" data-demo role="img" aria-label={`Illustration of the Cloudgate deploy screen for ${featured.name}: after creating an account, choose a server from Cloudgate or one you already have`}>
            <div class="wbar">
              <b>Cloudgate</b>
              <span>/</span>
              <span>New app</span>
              <span class="sp" />
              <span class="pill">Acme Bakery</span>
            </div>
            <div class="dep" aria-hidden="true" inert>
              <div class="steps">
                <div class="done"><span class="n"><Check /></span>Create account</div>
                <div class="on" data-step="2"><span class="n">2</span>Choose a server</div>
                <div data-step="3"><span class="n">3</span>Set up</div>
                <div data-step="4"><span class="n">4</span>Open app</div>
              </div>
              <div class="mid">
                <span class="lab">App</span>
                <div class="chosen">
                  <AppTile template={featured} box={36} size={22} loading="eager" />
                  <div class="grow">
                    <div class="h3">{featured.name}</div>
                    <div class="muted small">{featured.tagline}</div>
                  </div>
                  <span class="muted small">Change</span>
                </div>
                <span class="lab">Server</span>
                <div class="srv">
                  <span class="on"><i class="rd" />Get a server from Cloudgate</span>
                  <span><i class="rd" />Use a server I already have</span>
                </div>
                <span class="lab">Your domain</span>
                <div class="chosen addr">
                  <span class="grow">{featured.id.replace(/[^a-z0-9]/g, '')}.acmebakery.com</span>
                  <span class="muted small" data-demo-addr>https, set up for you</span>
                </div>
              </div>
              <div class="side">
                <div class="sumrow"><span>App</span><span>{featured.name}</span></div>
                <div class="sumrow"><span>Server</span><span>New, from Cloudgate</span></div>
                {replaced && <div class="sumrow"><span>Replaces</span><span>{replaced.name}</span></div>}
                <div class="sumrow"><span>App cost</span><span>Free</span></div>
                <span class="btn wide" data-demo-go data-live={`Open ${featured.name}`}>
                  Deploy {featured.name}
                </span>
                <div class="dbar"><span /></div>
                <div class="log">
                  <div><span class="ok"><Check /></span> Account created</div>
                  <div><span class="ok"><Check /></span> {featured.name} chosen</div>
                  <div data-demo-log data-run={`· Setting up ${featured.name}…`} data-live={`${featured.name} is live`}>
                    · Ready in a few minutes
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <ol class="caption">
          <li>
            <b>1</b>Choose an app
          </li>
          {steps.map((step, index) => (
            <li>
              <b>{index + 2}</b>
              {step.name}
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="sec" id="why" aria-labelledby="why-title">
    <div class="shead pad">
      <h2 class="h2" id="why-title">Why run these apps on your own server</h2>
      <p class="lede">
        The same jobs your paid tools do, without paying for every person. Cloudgate looks after the technical parts:
        <a href={cloudgate('features')}>see what Cloudgate does</a>.
      </p>
    </div>
    <div class="bento">
      <div class="tile t-a pad" data-reveal>
        <div class="tx">
          <h3 class="h3">Backups on the schedule you choose</h3>
          <p>For apps that keep their data in a database Cloudgate runs, set a schedule once, for example every night, and copies go to storage you choose, away from the server. Restore any copy when you need it.</p>
        </div>
        <div class="frag" role="img" aria-label="Example backup history: a backup every night at 02:00, 14 days kept">
          <div class="tl" aria-hidden="true">
            {
              nights.map((day, i) => (
                <div>
                  <span class="d">{day}</span>
                  <span class:list={['b', { next: i === 6 }]} style={`--i:${i}`}>{i === 6 ? '·' : <Check />}</span>
                  <span class="h">02:00</span>
                </div>
              ))
            }
          </div>
          <div class="foot1" aria-hidden="true"><span>Last backup <b>Sat 02:00</b>, finished in 3 min</span><span>14 days kept</span></div>
        </div>
      </div>
      <div class="tile t-b pad" data-reveal style="--d:1">
        <div class="tx">
          <h3 class="h3">Your data stays where you put it</h3>
          <p>Customer lists and files live on your server, in the country you choose.</p>
        </div>
        <div class="frag server" role="img" aria-label="Example server card: Shop server in Frankfurt, Germany, online">
          <div class="top1" aria-hidden="true"><span class="flag" /><b>Shop server</b><span class="status"><i />Online</span></div>
          <div class="r" aria-hidden="true"><span>Location</span><span>Frankfurt, Germany</span></div>
          <div class="r" aria-hidden="true"><span>Apps running</span><span>{[featured, second].filter(Boolean).map((t) => t!.name).join(', ')}</span></div>
          <div class="r" aria-hidden="true"><span>Backups go to</span><span>Storage you choose</span></div>
        </div>
      </div>
      <div class="tile t-c pad" data-reveal>
        <div class="tx">
          <h3 class="h3">No server? Cloudgate provides one</h3>
          <p>Pick a size and a country when you deploy, and Cloudgate gets the server ready for your app.</p>
        </div>
        <div class="frag server reveal-rows" role="img" aria-label="Example server from Cloudgate: small size, in Germany, ready for the app">
          <div class="r" aria-hidden="true"><span>Size</span><span>Small</span></div>
          <div class="r" aria-hidden="true"><span>Country</span><span>Germany</span></div>
          {featured && <div class="r" aria-hidden="true"><span>Ready for</span><span>{featured.name}</span></div>}
        </div>
      </div>
      <div class="tile t-d pad" data-reveal style="--d:1">
        <div class="tx">
          <h3 class="h3">Add the whole team. No per-seat pricing.</h3>
          <p>The apps are free and charge nothing per person, so adding a colleague costs nothing.</p>
        </div>
        <div class="frag" role="img" aria-label="Example team pricing: 12 team members, nothing per person, a free app">
          <div class="seats" aria-hidden="true">{seats.map((x, i) => <span style={`--i:${i}`}>{x}</span>)}</div>
          <div class="price" aria-hidden="true">
            <span>Team members</span><span>12</span><span>Price per person</span><span>$0</span><span class="tot">App price</span><span class="tot">Free</span>
          </div>
          <p class="ex">Plus your server, the same for 2 people or 20</p>
        </div>
      </div>
    </div>
  </section>

  {
    swaps.length > 0 && (
      <section class="sec swaps" id="swaps" aria-labelledby="swaps-title">
        <div class="shead pad">
          <div>
            <h2 class="h2" id="swaps-title">Popular swaps</h2>
            <p class="lede">The tools people most often replace first, and what they move to.</p>
          </div>
          {topAlternatives && (
            <a class="btn ghost" href={href(`alternatives/${topAlternatives.product.id}/`)}>
              All {topAlternatives.product.name} alternatives <Chev />
            </a>
          )}
        </div>
        <div class="pad">
          <div class="swrow">
            {swaps.map((swap) => (
              <a class="sw" href={href(swap.href)} data-swap>
                <div class="art">
                  <ProductTile product={swap.product} box={60} size={32} class="from" />
                  <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                    <path d="M2 8h11M9.5 4.5 13 8l-3.5 3.5" pathLength="1" />
                  </svg>
                  <AppTile template={swap.app} box={60} size={34} />
                </div>
                <div class="pair">
                  {swap.product.name}
                  <span>to</span>
                  {swap.app.name}
                </div>
                <p class="why">{swap.why}</p>
                <span class="go">
                  {swap.go} <Chev />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="sec cat" id="catalogue" aria-labelledby="catalogue-title">
    <div class="shead pad">
      <h2 class="h2" id="catalogue-title">Browse apps</h2>
      <p class="lede">Search by what you want to do, or by the tool you pay for today.</p>
    </div>
    <div class="fbar">
      <div class="in pad">
        <div class="seg" role="toolbar" aria-label="Filter by category">
          <button type="button" data-tab="" aria-pressed="true">All</button>
          {categories.map((category) => <button type="button" data-tab={category.id} aria-pressed="false">{category.name}</button>)}
        </div>
        <label class="sbox"
          ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
            ><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg
          >
          <input id="q" type="search" autocomplete="off" placeholder="Filter, e.g. Slack" aria-label="Filter apps" /></label
        >
      </div>
    </div>
    <div class="gridwrap pad">
      <div class="grid" id="grid">
        {templates.map((template) => <Card template={template} />)}
        <div class="empty" id="empty" hidden>
          <p class="msg" id="emptyMsg"></p>
          <p class="hint">Try a tool you pay for, like Zapier, Notion or Slack. If the app you need is missing, you can add it.</p>
          <div class="eacts">
            <button type="button" class="btn sm ghost" id="clear">Clear the filter</button>
            <a class="btn sm ghost" href={href('contribute/')}>Add an app <Chev /></a>
          </div>
        </div>
      </div>
      <div id="moreWrap" data-page={PAGE}>
        <p class="fine" id="count" aria-live="polite"></p>
      </div>
      <p class="fine legend">
        <span><span class="ease easy"><i></i>Easy</span>: ready to use right after setup.</span>
        <span><span class="ease some"><i></i>Some setup</span>: a few extra minutes of setup inside the app.</span>
        <a href={href('templates/')}>See all {total} apps on one page</a>
      </p>
    </div>
  </section>

  <section class="sec pad" id="faq" aria-labelledby="faq-title">
    <div class="blk faqblk">
      <h2 class="h2" id="faq-title">Questions before you deploy</h2>
      <Faq items={faq} />
      <p class="muted selfhost">
        Prefer to run everything yourself? <a href={cloudgate('self-hosted')}>Install Cloudgate on your own server for free</a>, then
        deploy any app here from your own console.
      </p>
    </div>
  </section>
</Base>

<style>
  .faqblk {
    border-top: 0;
    padding-top: 72px;
  }
  .empty .msg {
    color: var(--fg);
    font-weight: 500;
  }
  .empty .hint {
    margin: 6px auto 0;
    max-width: 52ch;
  }
  .eacts {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .legend a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }
  .selfhost {
    margin-top: 20px;
    max-width: 64ch;
    font-size: var(--t-base);
  }
  .selfhost a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }
</style>

<script>
  // Category tabs, the filter box and "Load more". Every card is in the HTML, so the page reads
  // completely without JavaScript; this only narrows what is shown.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const input = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const emptyMsg = document.getElementById('emptyMsg') as HTMLElement;
  const clear = document.getElementById('clear') as HTMLButtonElement;
  const wrap = document.getElementById('moreWrap') as HTMLElement;
  const count = document.getElementById('count') as HTMLElement;
  const page = Number(wrap.dataset.page);
  const total = cards.length;
  let cat = new URLSearchParams(location.search).get('category') ?? '';
  let shown = page;
  const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  const more = document.createElement('button');
  more.className = 'more';
  more.type = 'button';
  more.addEventListener('click', () => {
    shown = total;
    render(true);
  });

  /**
   * Cards that a click brought into view rise in, a few at a time. Typing in the filter box
   * shows results instantly: it happens on every keystroke, and motion there would only lag.
   */
  function enter(added: HTMLElement[]) {
    if (!motion) return;
    added.slice(0, 12).forEach((c, i) =>
      c.animate(
        [
          { opacity: 0, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'none' },
        ],
        { duration: 280, delay: i * 25, easing: 'cubic-bezier(.23,1,.32,1)', fill: 'backwards' },
      ),
    );
  }

  function render(animate = false) {
    const before = new Set(cards.filter((c) => !c.hidden));
    const q = input.value.trim().toLowerCase();
    const filtered = Boolean(cat || q);
    const matches = cards.filter((c) => (!cat || c.dataset.cat === cat) && (!q || (c.dataset.q ?? '').includes(q)));
    const visible = filtered ? matches : matches.slice(0, shown);
    cards.forEach((c) => (c.hidden = !visible.includes(c)));
    tabs.forEach((t) => t.setAttribute('aria-pressed', String((t.dataset.tab ?? '') === cat)));
    if (animate) enter(visible.filter((c) => !before.has(c)));
    const catName = tabs.find((t) => t.dataset.tab === cat)?.textContent;
    empty.hidden = matches.length > 0;
    const raw = input.value.trim();
    emptyMsg.textContent = raw ? `No apps match “${raw}”${cat ? ` in ${catName}` : ''}.` : `No apps in ${catName} yet.`;
    more.remove();
    if (filtered) {
      count.textContent = `${matches.length} of ${total} apps shown`;
    } else if (shown < total) {
      count.textContent = '';
      more.textContent = `Load more (${total - shown} remaining)`;
      wrap.prepend(more);
    } else {
      count.textContent = `All ${total} apps shown`;
    }
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      cat = t.dataset.tab ?? '';
      render(true);
      t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }),
  );
  input.addEventListener('input', () => render());
  clear.addEventListener('click', () => {
    cat = '';
    input.value = '';
    render();
    input.focus();
  });
  input.value = new URLSearchParams(location.search).get('q') ?? input.value;
  render();
</script>

<script>
  // The deploy demo on the stage: once it is in view, Deploy is pressed, the app is set up and goes
  // live, in under three seconds, then it stays put. The HTML is the moment before, so without
  // JavaScript or with reduced motion the picture is complete as it is.
  const win = document.querySelector<HTMLElement>('[data-demo]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (win && !reduce && 'IntersectionObserver' in window) {
    const q = <T extends HTMLElement>(s: string) => win.querySelector<T>(s)!;
    const go = q('[data-demo-go]');
    const log = q('[data-demo-log]');
    const addr = q('[data-demo-addr]');
    const bar = q('.dbar span');
    const step2 = q('[data-step="2"]');
    const step3 = q('[data-step="3"]');
    const step4 = q('[data-step="4"]');
    const tick = (step: HTMLElement) => (step.firstElementChild!.innerHTML = q('.steps .done .n').innerHTML);
    const EASE = 'cubic-bezier(.23,1,.32,1)';

    /** Swaps text with a short blur, so the two states read as one change. */
    const swap = (el: HTMLElement, html: string) => {
      el.innerHTML = html;
      el.animate(
        [
          { opacity: 0, filter: 'blur(3px)', transform: 'translateY(3px)' },
          { opacity: 1, filter: 'blur(0)', transform: 'none' },
        ],
        { duration: 260, easing: EASE },
      );
    };
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

    const play = () => {
      const at = (ms: number, f: () => void) => setTimeout(f, ms);
      at(0, () => go.classList.add('press'));
      at(160, () => {
        go.classList.remove('press');
        win.dataset.phase = 'run';
        step2.className = 'done';
        tick(step2);
        step3.className = 'on';
        swap(log, esc(log.dataset.run ?? ''));
        bar.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
          duration: 1700,
          easing: 'cubic-bezier(.45,.05,.35,1)',
          fill: 'forwards',
        });
      });
      at(1950, () => {
        win.dataset.phase = 'live';
        step3.className = 'done';
        tick(step3);
        step4.className = 'on live';
        tick(step4);
        swap(log, `<span class="ok">${q('.log .ok').innerHTML}</span> ${esc(log.dataset.live ?? '')}`);
        swap(go, esc(go.dataset.live ?? ''));
        swap(addr, '<span class="live-dot"><i></i>Live (https)</span>');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setTimeout(play, 500);
        }
      },
      { threshold: 0.6 },
    );
    io.observe(q('.side'));
  }
</script>

<script>
  // Popular swaps: as each card comes into view the paid tool steps back, the arrow draws, and the
  // open-source app slides out from behind it into place. It plays once.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cardsWithSwap = [...document.querySelectorAll<HTMLElement>('[data-swap]')];
  if (!reduce && cardsWithSwap.length && 'IntersectionObserver' in window) {
    const EASE = 'cubic-bezier(.23,1,.32,1)';
    const busy = new WeakSet<HTMLElement>();

    const playSwap = (card: HTMLElement) => {
      if (busy.has(card)) return;
      busy.add(card);
      const art = card.querySelector<HTMLElement>('.art')!;
      const from = art.firstElementChild as HTMLElement;
      const to = art.lastElementChild as HTMLElement;
      const arrow = art.querySelector('svg.arr path')!;
      const dx = from.getBoundingClientRect().left - to.getBoundingClientRect().left;
      card.classList.remove('pending');
      from.animate(
        [
          { transform: 'none', opacity: 0.75 },
          { transform: 'translateX(-6px) scale(.94)', opacity: 0.3, offset: 0.35 },
          { transform: 'none', opacity: 0.75 },
        ],
        { duration: 700, easing: EASE },
      );
      arrow.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
        duration: 420,
        delay: 120,
        easing: EASE,
        fill: 'backwards',
      });
      to.animate(
        [
          { transform: `translateX(${dx}px) scale(.9)`, opacity: 0 },
          { transform: `translateX(${dx}px) scale(.9)`, opacity: 1, offset: 0.15 },
          { transform: 'none', opacity: 1 },
        ],
        { duration: 700, easing: EASE },
      ).onfinish = () => busy.delete(card);
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => cardsWithSwap.indexOf(a.target as HTMLElement) - cardsWithSwap.indexOf(b.target as HTMLElement))
          .forEach((e, k) => {
            io.unobserve(e.target);
            setTimeout(() => playSwap(e.target as HTMLElement), k * 90);
          });
      },
      { threshold: 0.6 },
    );
    cardsWithSwap.forEach((card) => {
      card.classList.add('pending');
      io.observe(card);
    });
  }
</script>
