---
import Base from '../layouts/Base.astro';
import AppTile from '../components/AppTile.astro';
import ProductTile from '../components/ProductTile.astro';
import Card from '../components/Card.astro';
import Chev from '../components/Chev.astro';
import Faq from '../components/Faq.astro';
import { alternativesPages, getTemplate, getTemplates, listNames, popularSwaps, usedCategories } from '../lib/catalogue';
import { faqSchema, graph, itemListSchema, websiteSchema } from '../lib/schema';
import { costAnswer } from '../lib/copy';
import { href, PLANS, SITE_DESCRIPTION } from '../lib/site';

const templates = getTemplates();
const total = templates.length;
const categories = usedCategories();
const swaps = popularSwaps();
const topAlternatives = alternativesPages().sort((a, b) => b.apps.length - a.apps.length)[0];
const PAGE = 20;

// The stage shows a real app from the catalogue being set up; n8n when it is there.
const featured = getTemplate('n8n') ?? templates[0];
const replaced = featured?.alternativeTo[0];
const second = templates.find((t) => t.id === 'plausible') ?? templates.find((t) => t.id !== featured?.id);
const nights = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Tonight'];
const seats = ['AK', 'JB', 'LM', 'SR', 'TO', 'EV', 'PN', 'MC', 'RD', 'HW', 'CL', 'NB'];

// Answers written to be quoted as they stand: each one names its subject instead of saying "it",
// and the examples come from the catalogue, so they stay true as apps are added.
const exampleSwaps = swaps.slice(0, 3);
const faq = [
  {
    q: 'What is Cloudgate Templates?',
    a: `Cloudgate Templates is a free directory of ${total} open-source apps${
      exampleSwaps.length
        ? `, such as ${listNames(exampleSwaps.map((swap) => `${swap.app.name} instead of ${swap.product.name}`))}`
        : ''
    }. Pick one and click Deploy, and Cloudgate, a deployment platform, sets it up on a server for you and gives it a web address.`,
  },
  {
    q: 'Do I need my own server?',
    a: 'No. When you deploy an app, Cloudgate can provide a server: pick a size and a country, and it is billed monthly on the same bill as your Cloudgate plan. If you already rent a server, you can connect it instead.',
  },
  {
    q: 'Do I need to be technical?',
    a: 'No. Pick an app, click Deploy, create your Cloudgate account and choose a server. Cloudgate does the setup, and you use the app in your browser like any online tool. Some apps need a few minutes of setup inside the app itself; their pages are marked “Some setup”.',
  },
  {
    q: 'What does it cost?',
    a: costAnswer(),
  },
  {
    q: 'What is Cloudgate?',
    a: 'Cloudgate is a deployment platform made by Octabyte: a console in your browser that sets up and runs apps on servers and gives each app a web address. You can use it hosted at cloudgate.octabyte.app, or install it on your own server for free. It is source-available under the Elastic License 2.0.',
  },
  {
    q: 'Is my app secure on its web address?',
    a: 'Every app gets a free web address to start, which uses plain http, so it is not encrypted. Add your own domain, like crm.yourshop.com, and Cloudgate sets up https for it automatically.',
  },
  {
    q: 'Can I suggest or add an app?',
    a: 'Yes. Each app is a small folder of text files in the Cloudgate Templates repository on GitHub. Anyone can add one with a pull request from the GitHub website, without installing anything.',
  },
];

const jsonLd = graph(websiteSchema(), itemListSchema(templates, 'Open-source apps on Cloudgate'), faqSchema(faq));
---

<Base
  title="Deploy free open-source apps in a few clicks | Cloudgate"
  bareTitle
  description={SITE_DESCRIPTION}
  path=""
  jsonLd={jsonLd}
>
  <section class="hero pad">
    <p class="kicker">Cloudgate Templates</p>
    <h1 class="display">Open-source apps, ready to run on your own server</h1>
    <div class="row2">
      <p class="lede">
        Pick a free app that does the job of a tool you pay for today and click Deploy. No server yet? Cloudgate can
        provide one, so your app is live in minutes with nothing to install.
      </p>
      <div class="acts">
        <a class="btn lg" href="#catalogue">Browse {total} apps</a>
        <a class="btn lg ghost" href={href('how-it-works/')}>How it works <Chev /></a>
      </div>
    </div>
    <div class="facts-strip"><span><b>{total}</b> free apps</span><span><b>{PLANS.trialDays}-day</b> free trial</span><span>Server provided if you need one</span></div>
  </section>

  {
    featured && (
      <section class="stagewrap pad" id="how" aria-labelledby="how-title">
        <h2 id="how-title" class="visually-hidden">How it works</h2>
        <div class="stage">
          <div class="window" role="img" aria-label={`Illustration of the Cloudgate deploy screen for ${featured.name}: after creating an account, choose a server from Cloudgate or one you already have`}>
            <div class="wbar">
              <b>Cloudgate</b>
              <span>/</span>
              <span>New app</span>
              <span class="sp" />
              <span class="pill">Acme Bakery</span>
            </div>
            <div class="dep" aria-hidden="true">
              <div class="steps">
                <div class="done"><span class="n">✓</span>Choose an app</div>
                <div class="done"><span class="n">✓</span>Create account</div>
                <div class="on"><span class="n">3</span>Choose a server</div>
                <div><span class="n">4</span>Live</div>
              </div>
              <div class="mid">
                <span class="lab">App</span>
                <div class="chosen">
                  <AppTile template={featured} box={36} size={22} />
                  <div style="min-width:0">
                    <div class="h3">{featured.name}</div>
                    <div class="muted" style="font-size:13px">
                      {featured.tagline}
                    </div>
                  </div>
                  <span style="flex:1" />
                  <span class="muted" style="font-size:13px">Change</span>
                </div>
                <span class="lab">Server</span>
                <div class="srv">
                  <label class="on"><input type="radio" name="hs" checked tabindex="-1" /> Get a server from Cloudgate <small>on your monthly bill</small></label>
                  <label><input type="radio" name="hs" tabindex="-1" /> Use a server I already have</label>
                </div>
                <span class="lab">Web address</span>
                <div class="chosen" style="padding:9px 12px;font-size:13.5px">
                  <span>{featured.id.replace(/[^a-z0-9]/g, '')}.acmebakery.com</span>
                  <span style="flex:1" />
                  <span class="muted" style="font-size:12.5px">secure (https)</span>
                </div>
              </div>
              <div class="side">
                <div class="sumrow"><span>App</span><span>{featured.name}</span></div>
                <div class="sumrow"><span>Server</span><span>New, from Cloudgate</span></div>
                {replaced && <div class="sumrow"><span>Replaces</span><span>{replaced.name}</span></div>}
                <div class="sumrow"><span>App cost</span><span>Free</span></div>
                <div class="sumrow"><span>Cloudgate</span><span>{PLANS.trialDays}-day free trial</span></div>
                <span class="btn" style="width:100%">Deploy {featured.name}</span>
                <div class="log">
                  <div><span class="ok">✓</span> Account created</div>
                  <div><span class="ok">✓</span> {featured.name} chosen</div>
                  <div>· Ready in a few minutes</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <ol class="caption" style="list-style:none;padding:0;margin-block:22px 0">
          <li><b>1</b>Pick an app and click Deploy</li>
          <li><b>2</b>Create your account</li>
          <li><b>3</b>Choose a server, or get one from us</li>
          <li><b>4</b>Open your app</li>
        </ol>
      </section>
    )
  }

  <section class="sec" id="why" aria-labelledby="why-title">
    <div class="shead pad">
      <h2 class="h2" id="why-title">Why run apps with Cloudgate</h2>
      <p class="lede">The same jobs your paid tools do, without paying for every person. Cloudgate looks after the technical parts.</p>
    </div>
    <div class="bento">
      <div class="tile t-a pad">
        <div class="tx">
          <h3 class="h3">Backups on the schedule you choose</h3>
          <p>For apps that keep their data in a database Cloudgate runs, set a schedule once, for example every night, and copies go to storage you choose, away from the server. Restore any copy when you need it.</p>
        </div>
        <div class="frag" role="img" aria-label="Example backup history: a backup every night at 02:00, 14 days kept">
          <div class="tl" aria-hidden="true">
            {
              nights.map((day, i) => (
                <div>
                  <span class="d">{day}</span>
                  <span class:list={['b', { next: i === 6 }]}>{i === 6 ? '·' : '✓'}</span>
                  <span class="h">02:00</span>
                </div>
              ))
            }
          </div>
          <div class="foot1" aria-hidden="true"><span>Last backup <b>Sat 02:00</b>, finished in 3 min</span><span>14 days kept</span></div>
        </div>
      </div>
      <div class="tile t-b pad">
        <div class="tx">
          <h3 class="h3">Your data stays where you put it</h3>
          <p>Customer lists and files live on your server, in the country you choose.</p>
        </div>
        <div class="frag server" role="img" aria-label="Example server card: Shop server in Frankfurt, Germany, online">
          <div class="top1" aria-hidden="true"><span class="flag" /><b>Shop server</b><span class="status"><i />Online</span></div>
          <div class="r" aria-hidden="true"><span>Location</span><span>Frankfurt, Germany</span></div>
          <div class="r" aria-hidden="true"><span>Apps running</span><span>{[featured, second].filter(Boolean).map((t) => t!.name).join(', ')}</span></div>
          <div class="r" aria-hidden="true"><span>Backups go to</span><span>Storage you choose</span></div>
        </div>
      </div>
      <div class="tile t-c pad">
        <div class="tx">
          <h3 class="h3">No server? Cloudgate provides one</h3>
          <p>Pick a size and a country when you deploy. The server goes on your monthly Cloudgate bill, and you see its price before you buy.</p>
        </div>
        <div class="frag server" role="img" aria-label="Example monthly bill: Cloudgate Starter plan, a server from Cloudgate, and the app, which is free">
          <div class="r" aria-hidden="true"><span>Cloudgate Starter</span><span>${PLANS.starter} a month</span></div>
          <div class="r" aria-hidden="true"><span>Server from Cloudgate</span><span>Shown before you buy</span></div>
          {featured && <div class="r" aria-hidden="true"><span>{featured.name}</span><span>Free</span></div>}
        </div>
      </div>
      <div class="tile t-d pad">
        <div class="tx">
          <h3 class="h3">Add the whole team. No per-seat pricing.</h3>
          <p>The apps are free, and Cloudgate does not charge per person. Your bill is the same whether 2 people use it or 20.</p>
        </div>
        <div class="frag" role="img" aria-label={`Example team pricing: 12 team members, nothing per person, Cloudgate Starter at $${PLANS.starter} a month plus the server`}>
          <div class="seats" aria-hidden="true">{seats.map((x) => <span>{x}</span>)}</div>
          <div class="price" aria-hidden="true">
            <span>Team members</span><span>12</span><span>Price per person</span><span>$0</span><span class="tot">Cloudgate Starter, per month</span><span class="tot">${PLANS.starter}</span>
          </div>
          <p class="ex" style="margin-top:10px">Plus your server, the same for 2 people or 20</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec cat" id="catalogue" aria-labelledby="catalogue-title">
    <div class="shead pad">
      <h2 class="h2" id="catalogue-title">Browse apps</h2>
      <p class="lede">Search by what you want to do, or by the tool you pay for today.</p>
    </div>
    <div class="fbar">
      <div class="in pad">
        <div class="seg" role="toolbar" aria-label="Filter by category">
          <button type="button" data-tab="" aria-pressed="true">All</button>
          {categories.map((category) => <button type="button" data-tab={category.id} aria-pressed="false">{category.name}</button>)}
        </div>
        <label class="sbox"
          ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
            ><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg
          >
          <input id="q" type="search" autocomplete="off" placeholder="Filter, e.g. Slack or newsletter" aria-label="Filter apps" /></label
        >
      </div>
    </div>
    <div class="gridwrap pad">
      <div class="grid" id="grid">
        {templates.map((template) => <Card template={template} />)}
        <div class="empty" id="empty" hidden></div>
      </div>
      <div id="moreWrap" data-page={PAGE}>
        <p class="fine" id="count" aria-live="polite"></p>
      </div>
    </div>
  </section>

  {
    swaps.length > 0 && (
      <section class="sec swaps" id="swaps" aria-labelledby="swaps-title">
        <div class="shead pad">
          <div>
            <h2 class="h2" id="swaps-title">Popular swaps</h2>
            <p class="lede">The tools people most often replace first, and what they move to.</p>
          </div>
          {topAlternatives && (
            <a class="btn ghost" href={href(`alternatives/${topAlternatives.product.id}/`)}>
              All {topAlternatives.product.name} alternatives <Chev />
            </a>
          )}
        </div>
        <div class="pad">
          <div class="swrow">
            {swaps.map((swap) => (
              <a class="sw" href={href(swap.href)}>
                <div class="art">
                  <ProductTile product={swap.product} box={60} size={32} class="from" />
                  <svg class="arr" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                    <path d="M2 8h11M9.5 4.5 13 8l-3.5 3.5" />
                  </svg>
                  <AppTile template={swap.app} box={60} size={34} />
                </div>
                <div class="pair">
                  {swap.product.name}
                  <span>to</span>
                  {swap.app.name}
                </div>
                <p class="why">{swap.why}</p>
                <span class="go">
                  {swap.go} <Chev />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="sec pad" id="faq" aria-labelledby="faq-title">
    <div class="blk" style="border-top:0;padding-top:72px">
      <h2 class="h2" id="faq-title">Questions before you deploy</h2>
      <Faq items={faq} />
      <p class="muted selfhost">
        Prefer to run everything yourself? <a href={href('get-cloudgate/')}>Install Cloudgate on your own server for free</a>, then
        deploy any app here from your own console.
      </p>
    </div>
  </section>
</Base>

<style>
  .selfhost {
    margin-top: 20px;
    max-width: 64ch;
    font-size: 14.5px;
  }
  .selfhost a {
    color: var(--accent-ink);
    text-underline-offset: 3px;
  }
</style>

<script>
  // Category tabs, the filter box and "Load more". Every card is in the HTML, so the page reads
  // completely without JavaScript; this only narrows what is shown.
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const input = document.getElementById('q') as HTMLInputElement;
  const empty = document.getElementById('empty') as HTMLElement;
  const wrap = document.getElementById('moreWrap') as HTMLElement;
  const count = document.getElementById('count') as HTMLElement;
  const page = Number(wrap.dataset.page);
  const total = cards.length;
  let cat = new URLSearchParams(location.search).get('category') ?? '';
  let shown = page;
  const more = document.createElement('button');
  more.className = 'more';
  more.type = 'button';
  more.addEventListener('click', () => {
    shown = total;
    render();
  });

  function render() {
    const q = input.value.trim().toLowerCase();
    const filtered = Boolean(cat || q);
    const matches = cards.filter((c) => (!cat || c.dataset.cat === cat) && (!q || (c.dataset.q ?? '').includes(q)));
    const visible = filtered ? matches : matches.slice(0, shown);
    cards.forEach((c) => (c.hidden = !visible.includes(c)));
    tabs.forEach((t) => t.setAttribute('aria-pressed', String((t.dataset.tab ?? '') === cat)));
    const catName = tabs.find((t) => t.dataset.tab === cat)?.textContent;
    empty.hidden = matches.length > 0;
    empty.textContent = `No apps match “${input.value}”${cat ? ` in ${catName}` : ''}. Try a tool you pay for, like Zapier, Notion or Slack.`;
    more.remove();
    if (filtered) {
      count.textContent = `${matches.length} of ${total} apps shown`;
    } else if (shown < total) {
      count.textContent = '';
      more.textContent = `Load more (${total - shown} remaining)`;
      wrap.prepend(more);
    } else {
      count.textContent = `All ${total} apps shown`;
    }
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      cat = t.dataset.tab ?? '';
      render();
      t.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    }),
  );
  input.addEventListener('input', render);
  input.value = new URLSearchParams(location.search).get('q') ?? input.value;
  render();
</script>
