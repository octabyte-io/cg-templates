---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Crumbs from '../../components/Crumbs.astro';
import { getTemplates, lastUpdated, licenceKind, usedCategories } from '../../lib/catalogue';
import type { Category } from '../../categories';
import { breadcrumbSchema, graph, itemListSchema } from '../../lib/schema';
import { href } from '../../lib/site';

export function getStaticPaths() {
  return usedCategories().map((category) => ({ params: { id: category.id }, props: { category } }));
}

interface Props {
  category: Category & { count: number };
}

const { category } = Astro.props;
const apps = getTemplates().filter((template) => template.category.id === category.id);
const others = usedCategories().filter((other) => other.id !== category.id);
const replaced = [...new Set(apps.flatMap((app) => app.alternativeTo.map((p) => p.name)))];
const trail = [
  { name: 'Home', path: '' },
  { name: category.name, path: `categories/${category.id}/` },
];
const allOpenSource = apps.every((app) => licenceKind(app.license).openSource);
// Lowercase the name for the title, but keep acronyms such as AI and PDFs.
const noun = category.name
  .split(' ')
  .map((word) => (/^[A-Z]{2,}s?$/.test(word) ? word : word.toLowerCase()))
  .join(' ');
const title = allOpenSource ? `Open-source ${noun} apps to self-host` : `Self-hosted ${noun} apps`;
// Name as many replaced products as fit in 160 characters, never cutting a name in half.
const describe = (names: string[]) =>
  `${category.lede} ${apps.length} free ${apps.length === 1 ? 'app' : 'apps'}${names.length ? `, replacing ${names.join(', ')}` : ''}.`;
const fitting = [3, 2, 1, 0].map((n) => describe(replaced.slice(0, n))).find((text) => text.length <= 160);
const description = fitting ?? category.lede;
---

<Base
  title={title}
  description={description}
  path={`categories/${category.id}/`}
  pageType="CollectionPage"
  dateModified={lastUpdated(apps)}
  jsonLd={graph(breadcrumbSchema(trail), itemListSchema(apps, title))}
>
  <Crumbs trail={trail} />
  <section class="apphead one pad">
    <div class="body">
      <h1 class="h1">{category.name}</h1>
      <p class="lede">{category.lede}</p>
      <div class="chips">
        <span class="chip"><b>{apps.length}</b> {apps.length === 1 ? 'app' : 'apps'}</span>
        <span class="chip"><b>Free</b> to use</span>
        {replaced.length > 0 && <span class="chip">Replaces <b>{replaced.slice(0, 3).join(', ')}</b></span>}
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="gridwrap tight pad">
      <div class="grid">{apps.map((app) => <Card template={app} />)}</div>
    </div>
  </section>
  <section class="sec browse pad">
    <h2 class="h2">Other categories</h2>
    <div class="idx">
      {
        others.map((other) => (
          <a href={href(`categories/${other.id}/`)}>
            <b>{other.name}</b>
            <span>{other.lede}</span>
            <small>
              {other.count} {other.count === 1 ? 'app' : 'apps'}
            </small>
          </a>
        ))
      }
    </div>
  </section>
</Base>
