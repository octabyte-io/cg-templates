---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base title="Page not found" path="404/" noindex>
  <section class="notfound pad">
    <h1 class="h1">That page is not here</h1>
    <p class="lede">The address may be mistyped, or the app may have moved. Search for it, or browse every app.</p>
    <div class="acts">
      <button class="btn lg" type="button" data-open-palette>Search apps</button>
      <a class="btn lg ghost" href={href('templates/')}>Browse all apps</a>
    </div>
  </section>
</Base>
