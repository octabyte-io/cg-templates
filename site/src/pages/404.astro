---
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
---

<Base
  title="Page not found"
  description="This page doesn’t exist or has moved. Browse every open-source app in the Cloudgate Templates catalogue, or search for the one you need."
  path="404/"
  noindex
>
  <section class="notfound pad">
    <h1 class="h1">That page is not here</h1>
    <p class="lede">The address may be mistyped, or the app may have moved. Search for it, or browse every app.</p>
    <div class="hero" style="padding:0;display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn lg" type="button" data-open-palette>Search apps</button>
      <a class="btn lg ghost" href={href('#catalogue')}>Browse all apps</a>
    </div>
  </section>
</Base>
