---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item, index) => (
      <details open={index === 0}>
        <summary>{item.q}<span class="pm" aria-hidden="true" /></summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>
