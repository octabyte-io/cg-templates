---
/**
 * The catalogue's filter bar: a search box, then one chip per category with how many apps it
 * holds. Shared by the home page and the all-apps page; their scripts read [data-tab] and #q.
 */
import type { Category } from '../categories';

interface Props {
  categories: (Category & { count: number })[];
  total: number;
}
const { categories, total } = Astro.props;
---

<div class="fbar">
  <div class="in pad">
    <label class="sbox"
      ><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
        ><circle cx="7" cy="7" r="5"></circle><path d="m11 11 3.5 3.5"></path></svg
      >
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="Search apps, or a tool you pay for like Slack"
        aria-label="Search apps by name, job or the tool they replace"
      /></label
    >
    <div class="segwrap">
    <div class="seg one" id="seg" role="toolbar" aria-label="Filter by category">
      <button type="button" data-tab="" data-label="All" aria-pressed="true">All<span class="n">{total}</span></button>
      {
        [...categories].sort((a, b) => b.count - a.count).map((category) => (
          <button type="button" data-tab={category.id} data-label={category.name} aria-pressed="false">
            {category.name}
            <span class="n">{category.count}</span>
          </button>
        ))
      }
    </div>
    <button type="button" class="segmore" aria-expanded="false" aria-controls="seg" data-segmore>
      <span data-segmore-label>More categories</span>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
    </button>
    </div>
  </div>
</div>
<noscript><style>.seg.one{max-height:none;padding:0;margin:0;overflow:visible}.segmore{display:none}</style></noscript>

<script>
  // Categories show as one row, biggest first, with a button that opens the rest. The chips that do
  // not fit the row are hidden (so Tab skips them) until it is opened. The bar is drawn as one row
  // with the button from the start (.seg.one clips the rest), so nothing moves when this runs.
  // Without JavaScript every chip shows, wrapped.
  const seg = document.getElementById('seg');
  const more = document.querySelector<HTMLButtonElement>('[data-segmore]');
  const label = document.querySelector<HTMLElement>('[data-segmore-label]');
  if (seg && more && label) {
    let chips = [...seg.querySelectorAll<HTMLButtonElement>('button')];
    let open = false;
    const layout = () => {
      chips.forEach((chip) => (chip.hidden = false));
      more.hidden = false;
      if (open) {
        seg.classList.remove('one');
        label.textContent = 'Fewer categories';
        more.setAttribute('aria-expanded', 'true');
        return;
      }
      seg.classList.add('one');
      const top = chips[0].offsetTop;
      let hidden = chips.filter((chip) => chip.offsetTop > top);
      // The chosen category always shows: if it would fall past the row, it moves up next to "All".
      const pressed = chips.find((chip) => chip.getAttribute('aria-pressed') === 'true');
      if (pressed && hidden.includes(pressed)) {
        chips[0].after(pressed);
        chips = [...seg.querySelectorAll<HTMLButtonElement>('button')];
        hidden = chips.filter((chip) => chip.offsetTop > top);
      }
      hidden.forEach((chip) => (chip.hidden = true));
      more.hidden = hidden.length === 0;
      label.textContent = `More categories (${hidden.length})`;
      more.setAttribute('aria-expanded', 'false');
    };
    more.addEventListener('click', () => {
      open = !open;
      layout();
    });
    // Choosing a category (or ?category= in the address) closes the list, with the choice in the row.
    new MutationObserver(() => {
      open = false;
      layout();
    }).observe(seg, { subtree: true, attributes: true, attributeFilter: ['aria-pressed'] });
    let width = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === width) return;
      width = window.innerWidth;
      layout();
    });
    layout();
  }
</script>
