# From Fluxer's official edge Caddyfile (fluxer_rexctl/internal/stack/files/Caddyfile) in its
# "proxy" mode: Cloudgate's own proxy in front handles the domain and TLS, so this listens on
# plain port 80 and sends each path of the web address to the service behind it.
# Changes: the Rust services (app, admin) run in one fluxer-server container named rust, and
# the /livekit route for voice is left out, since this template does not include voice.
{
	servers {
		trusted_proxies static private_ranges
		protocols h1 h2c
	}
}

(upstream) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
		header_up -Forwarded
	}
}

:80 {
	encode zstd gzip

	handle /_health {
		respond "OK" 200
	}

	handle_path /api/* {
		import upstream api:8080
	}

	handle /gateway {
		rewrite * /
		import upstream gateway:8080
	}

	handle_path /gateway/* {
		import upstream gateway:8080
	}

	handle_path /media/* {
		import upstream media-proxy:8080
	}

	handle /admin {
		rewrite * /
		import upstream rust:18083
	}

	handle_path /admin/* {
		import upstream rust:18083
	}

	@staticAssets path /web/* /emoji/* /libs/* /avatars/* /badges/* /desktop/*
	handle @staticAssets {
		import upstream static-proxy:8080
	}

	handle /.well-known/fluxer {
		import upstream api:8080
	}

	handle /.well-known/webfinger {
		import upstream api:8080
	}

	handle {
		import upstream rust:8080
	}
}

# Internal only: the web app reads the instance's discovery document here.
:8088 {
	handle /.well-known/fluxer {
		import upstream api:8080
	}
}
